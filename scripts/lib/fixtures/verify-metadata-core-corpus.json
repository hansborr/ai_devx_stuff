  "defectFixes": [
    {
      "name": "string-field decodes escaped quotes instead of truncating",
      "legacyBehavior": "sed extractor stopped at the first escaped quote: emitted 'echo \\' for this document",
      "argv": ["string-field", "command"],
      "stdin": "{\"command\":\"echo \\\"hi\\\" \\\\ and\\ttab\"}",
      "expectExitCode": 0,
      "expectStdout": "echo \"hi\" \\ and\ttab\n"
    },
    {
      "name": "string-field reads the top-level key instead of greedily binding the last occurrence",
      "legacyBehavior": "greedy ^.* bound the LAST \"mode\": emitted 'second' for this document",
      "argv": ["string-field", "mode"],
      "stdin": "{\"mode\":\"first\",\"nested\":{\"mode\":\"second\"}}",
      "expectExitCode": 0,
      "expectStdout": "first\n"
    },
    {
      "name": "string-field refuses a non-JSON document instead of pattern-matching inside garbage",
      "legacyBehavior": "sed matched key-shaped text inside arbitrary non-JSON input: emitted 'sneaky' for this document",
