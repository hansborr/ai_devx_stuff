docs/agent_notes/LOG.md merge=union
# Append-only JSONL acceptance log (see scripts/lint-ratchet/paths.ts); union
# merge is safe because each line is an independent record. Do NOT add the
# baseline JSON here — it is a structured document, not line-appendable.
# Both patterns are anchored to the repo root so same-named fixtures committed
# under test directories never pick up these merge semantics.
/lint-ratchet.debt-log.jsonl merge=union
# Derived from the source tree, so no textual merge is ever correct. The custom
# driver first attempts the semantic three-way baseline merge. If that cannot
# resolve safely, it keeps "ours" as valid JSON, prints the manual recovery
# recipe, and declares a conflict; see docs/guides/lint-ratchet-merges.md.
/lint-ratchet.baseline.json merge=lint-ratchet-baseline
# Identity entries are authoritative and the summary is derived. The custom
# driver keeps disjoint drains from corrupting summary-vs-entry consistency.
/sensor-knip-unused-exports.baseline.json merge=knip-unused-exports-baseline
# Near-duplicate pair identities are a shrink-only floor; intersect independent
# drains and truth up the result against the merged source tree.
/sensor-near-duplicates.baseline.json merge=near-duplicates-baseline
# Per-file max-lines cap exceptions keep hard-fail summary semantics, so the
# custom driver must regenerate a normalized summary after semantic merges.
/eslint-config/max-lines-exceptions.baseline.json merge=max-lines-exceptions-baseline

