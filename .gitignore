# Dependencies
node_modules/
package-lock.json

# Build output
dist/
build/
*.tsbuildinfo

# Environment (secrets)
.env
.env.*
!.env.example
.devcontainer/.env

# Logs
logs/
*.log
ralph-logs/
tmp/

# Devcontainer sentinel
.setup-complete

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
*.swp
*.swo

# Claude Code — track shared settings, hooks, and shared skills; ignore
# everything else (settings.local.json, personal skills, worktrees/,
# scheduled state, etc.). Shared skills live under .claude/skills/<name>/
# and must be opted in individually below.
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/skills/
.claude/skills/*
!.claude/skills/ts-graph/
!.claude/skills/playwright-cli/
!.claude/skills/playwright-cli/**

# Codex — track shared skills opted in below; keep personal repo-local skills
# out of git.
.codex/skills/*
!.codex/skills/ts-graph/
!.codex/skills/ts-graph/**
!.codex/skills/playwright-cli/
!.codex/skills/playwright-cli/**

# SRD reference repos (local only, not committed)
docs/refs/

# Prisma
packages/server/prisma/*.db
packages/server/prisma/*.db-journal

# Test artifacts
coverage/
reports/mutation/
reports/drift-ai/
.musi-ai-hooks-tidy-test.*/
.stryker-tmp/
test-results/
playwright-report/
blob-report/
playwright/.cache/
.playwright-mcp/
.playwright-cli/
screenshots/
.auth/

# Uploads (user-uploaded files, created at runtime)
uploads/

# Keys / certificates
*.pem
*.key

# Secondary worktrees (see scripts/worktree-db.sh)
worktrees/
.worktree-state/

# Stop-hook kill switches (touch to disable checks on stop; per-checkout)
.no-stop-uncommitted
.no-stop-e2e
.no-stop-async-verify
