#!/bin/bash
# Fast-commit backstop. Refuse publishing commits that were created while
# fast-commit mode was active until the current tip has fresh full-verify
# evidence.

if [ -z "${BASH_VERSION:-}" ]; then
  exec bash "$0" "$@"
fi

set -u

REPO_ROOT="$(git rev-parse --show-toplevel)"

# shellcheck source=/dev/null
. "$REPO_ROOT/scripts/lib/gate-env.sh"

# shellcheck source=/dev/null
. "$REPO_ROOT/scripts/lib/verify-metadata.sh"

ZERO_SHA="0000000000000000000000000000000000000000"

musi_pre_push_fast_marker() {
  printf '%s/musi-fast-commit' "$(musi_git_common_identity_path "$REPO_ROOT")"
}

musi_pre_push_fast_log() {
  musi_fast_commit_log_path "$REPO_ROOT"
}

musi_pre_push_freshness_seconds() {
  # HEAD plus ai_worktree_fingerprint pins tracked files, tracked diffs, and
  # untracked visible files. This window only bounds drift the fingerprint cannot
  # see: ignored build/dependency artifacts, local DB state, and tool/env
  # versions. Full verify commonly takes several minutes, so one hour avoids
  # forcing redundant verifies immediately after a clean run while still limiting
  # unseen local-state drift. The env override may tighten or loosen that bound.
  local default="$MUSI_GATE_PRE_PUSH_FRESHNESS_SECONDS"
  local value="${MUSI_PRE_PUSH_VERIFY_FRESHNESS_SECONDS:-$default}"

  if [[ "$value" =~ ^[1-9][0-9]*$ ]]; then
    printf '%s' "$value"
  else
    printf '%s' "$default"
  fi
}

musi_pre_push_json_string() {
  local file="$1"
  local key="$2"

  jq -r --arg key "$key" '.[$key] // empty' "$file" 2>/dev/null || true
}

musi_pre_push_json_int() {
  local file="$1"
  local key="$2"

  jq -r --arg key "$key" 'if (.[$key] | type) == "number" then .[$key] else empty end' \
    "$file" 2>/dev/null || true
}

musi_pre_push_full_verify_marker_matches() {
  local head="$1"
  local fingerprint="$2"
  local marker

  marker="${MUSI_VERIFY_MARKER_FULL:-$(musi_standard_verify_full_marker "$REPO_ROOT")}"
  musi_success_marker_matches "$marker" "$head" "$fingerprint" "$(musi_pre_push_freshness_seconds)"
}

musi_pre_push_full_verify_wrapper_matches() {
  local head="$1"
  local fingerprint="$2"
  local wrapper mode exit_code recorded_head recorded_fp end_time end_ts now age

  wrapper="${MUSI_VERIFY_LOG_DIR:-$(musi_standard_verify_log_dir "$REPO_ROOT")}/meta/wrapper.json"
  musi_fingerprint_is_valid "$fingerprint" || return 1
  [ -f "$wrapper" ] || return 1

  mode=$(musi_pre_push_json_string "$wrapper" mode)
  case "$mode" in
    serial-verify|parallel-verify) ;;
    *) return 1 ;;
  esac

  exit_code=$(musi_pre_push_json_int "$wrapper" exit_code)
  [ "$exit_code" = "0" ] || return 1

  recorded_head=$(musi_pre_push_json_string "$wrapper" head)
  [ "$recorded_head" = "$head" ] || return 1

  recorded_fp=$(musi_pre_push_json_string "$wrapper" fingerprint)
  musi_fingerprint_is_valid "$recorded_fp" || return 1
  [ "$recorded_fp" = "$fingerprint" ] || return 1

  end_time=$(musi_pre_push_json_string "$wrapper" end_time)
  [ -n "$end_time" ] || return 1
  end_ts=$(date -d "$end_time" +%s 2>/dev/null) || return 1
  now=$(date +%s)
  age=$((now - end_ts))
  [ "$age" -ge 0 ] || return 1
  [ "$age" -lt "$(musi_pre_push_freshness_seconds)" ] || return 1
}

musi_pre_push_has_full_verify_evidence() {
  local head fingerprint

  head=$(git -C "$REPO_ROOT" rev-parse HEAD 2>/dev/null || echo none)
  fingerprint=$(musi_require_fingerprint \
    "pre-push provenance" ai_worktree_fingerprint "$REPO_ROOT") || return 1

  musi_pre_push_full_verify_marker_matches "$head" "$fingerprint" \
    || musi_pre_push_full_verify_wrapper_matches "$head" "$fingerprint"
}

musi_pre_push_ref_updates() {
  local _local_ref local_sha _remote_ref remote_sha saw_input=0

  while read -r _local_ref local_sha _remote_ref remote_sha; do
    saw_input=1
    [ -n "${local_sha:-}" ] || continue
    [ "$local_sha" = "$ZERO_SHA" ] && continue
    [ -n "${remote_sha:-}" ] || remote_sha="$ZERO_SHA"
    printf '%s\t%s\n' "$local_sha" "$remote_sha"
  done

  if [ "$saw_input" -eq 0 ]; then
    local head
    head=$(git -C "$REPO_ROOT" rev-parse HEAD 2>/dev/null || true)
    [ -n "$head" ] && printf '%s\t%s\n' "$head" "$ZERO_SHA"
  fi
}

musi_pre_push_fail() {
  local detail="$1"

  cat >&2 <<EOF
pre-push: fast-commit provenance requires a fresh full verify before publication.
pre-push: $detail

Run one of the sanctioned full-verification paths, then retry the push:
  bash scripts/land.sh
  bun run verify

Bypass caveat: git push --no-verify skips this local hook. Repository AI policy
blocks agent-issued push bypass attempts, but a human bypass still skips this
backstop. Fix verification instead of bypassing it.
EOF
}

musi_pre_push_fast_commits_for_update() {
  local local_sha="$1"
  local remote_sha="$2"
  local log="$3"
  local logged

  [ -f "$log" ] || return 0
  while IFS= read -r logged; do
    [ -n "$logged" ] || continue
    git -C "$REPO_ROOT" cat-file -e "$logged^{commit}" 2>/dev/null || continue
    git -C "$REPO_ROOT" merge-base --is-ancestor "$logged" "$local_sha" 2>/dev/null || continue
    if [ "$remote_sha" != "$ZERO_SHA" ] \
       && git -C "$REPO_ROOT" cat-file -e "$remote_sha^{commit}" 2>/dev/null \
       && git -C "$REPO_ROOT" merge-base --is-ancestor "$logged" "$remote_sha" 2>/dev/null; then
      continue
    fi
    printf '%s\n' "$logged"
  done < "$log"
}

musi_pre_push_required_fast_commits() {
  local updates="$1"
  local log="$2"
  local local_sha remote_sha

  [ -f "$log" ] || return 0
  while IFS=$'\t' read -r local_sha remote_sha; do
    [ -n "$local_sha" ] || continue
    musi_pre_push_fast_commits_for_update "$local_sha" "$remote_sha" "$log"
  done <<< "$updates" | LC_ALL=C sort -u
}

musi_pre_push_main() {
  local updates="$1"
  local fast_log head local_sha remote_sha required

  fast_log=$(musi_pre_push_fast_log)

  [ -n "$updates" ] || return 0

  required=$(musi_pre_push_required_fast_commits "$updates" "$fast_log")
  [ -n "$required" ] || return 0

  head=$(git -C "$REPO_ROOT" rev-parse HEAD 2>/dev/null || echo none)
  while IFS=$'\t' read -r local_sha remote_sha; do
    [ -n "$local_sha" ] || continue
    if [ -n "$(musi_pre_push_fast_commits_for_update "$local_sha" "$remote_sha" "$fast_log")" ] \
       && [ "$local_sha" != "$head" ]; then
      musi_pre_push_fail \
        "pushing $local_sha, but full-verify evidence can only be checked for current HEAD $head."
      return 1
    fi
  done <<< "$updates"

  if musi_pre_push_has_full_verify_evidence; then
    musi_fast_commit_log_clear "$REPO_ROOT" "$required" || true
    return 0
  fi

  musi_pre_push_fail \
    "no fresh full verify metadata matches current HEAD $head and the worktree fingerprint."
  return 1
}

# Loads the generated near-duplicates boundary trigger. The ERE is data, not
# hook policy: it is rendered from the scanner's own source-extension truth
# (BUILT_IN_SOURCE_EXTENSIONS in scripts/drift-ai/scope.ts plus
# drift-ai.config.json additionalSourceExtensions) together with the whole-file
# inputs that change detector truth without touching any scanned source. The
# hook used to carry that pattern by hand with a checker re-parsing this file;
# sourcing the fragment removes both the seam and the parser. Fail closed: a
# missing or empty fragment means the trigger cannot be evaluated, and silently
# skipping the boundary scan is exactly the drift this check exists to stop.
musi_pre_push_load_scope_trigger() {
  local fragment="$REPO_ROOT/scripts/harness/pre-push-scope-trigger.generated.sh"

  # Only the generated fragment may satisfy the guard below. An inherited
  # export of the same name — a stale value left in the environment by a shell
  # profile, a wrapper, or an earlier checkout — would otherwise pass the -n
  # test and hand the scan an obsolete ERE, which is the silent skip this
  # fail-closed contract exists to stop.
  unset MUSI_PRE_PUSH_NEAR_DUPLICATES_TRIGGER

  if [ -f "$fragment" ]; then
    # shellcheck source=../scripts/harness/pre-push-scope-trigger.generated.sh
    . "$fragment"
  fi

  if [ -n "${MUSI_PRE_PUSH_NEAR_DUPLICATES_TRIGGER:-}" ]; then
    return 0
  fi

  cat >&2 <<EOF
pre-push: the generated near-duplicates boundary trigger is missing or empty.
pre-push: expected MUSI_PRE_PUSH_NEAR_DUPLICATES_TRIGGER from $fragment.
pre-push: without it this hook cannot tell whether the pushed range touches scanned source, so
pre-push: the whole-tree baseline boundary check would be skipped silently. Regenerate and commit:
  bun run harness:pre-push-trigger

Bypass caveat: git push --no-verify skips this local hook. Repository AI policy
blocks agent-issued push bypass attempts. Regenerate the fragment instead of bypassing.
EOF
  return 1
}

# Blocking integration-boundary check for the near-duplicates baseline.
#
# Parallel-lane integration can assemble a branch whose committed
# sensor-near-duplicates.baseline.json is stale — a lane introduced a rule or
# added duplicates from source without regenerating the baseline — with no
# blocking signal before land-time full verify. Merge commits skip pre-commit,
# and the post-merge advisory only fires on the semantic merge-driver marker, so
# a whole-tree baseline drift slips through. pre-push is the last exit before
# integration, so gate it here.
#
# The whole-tree --check-baseline scan runs only when a pushed ref update touches
# an input of the generated trigger: a file whose extension the scanner walks
# (the TypeScript and JavaScript families, not just .ts/.tsx), the baseline
# file, or drift-ai.config.json. A docs-only push pays no scan; a config-only
# push does, because the config changes detector truth. The scan is deliberately
# NOT conditional on the merge-driver marker.
# --check-baseline exits 0 (truthful), 3 (stale whole-repo verdict), 6
# (unreviewed working-tree baseline growth over HEAD), or 1/2/127/other (an
# unclassified or environment failure that never established a verdict). Fail
# closed only on codes 3 and 6; surface an environment failure and let the push
# proceed so an infra outage cannot wedge integration.
musi_pre_push_near_duplicates_boundary() {
  local updates="$1"
  local baseline="sensor-near-duplicates.baseline.json"
  local local_sha remote_sha need_scan=0 changed ref_needs_scan head
  local check_status=0 check_output

  [ -f "$REPO_ROOT/$baseline" ] || return 0
  [ -n "$updates" ] || return 0

  musi_pre_push_load_scope_trigger || return 1

  # The whole-tree --check-baseline scan below reads the current worktree
  # checkout, so its verdict is only evidence about HEAD. Mirror the fast-commit
  # backstop above (musi_pre_push_main): a scan-needing tip that is not HEAD
  # cannot be validated from this worktree, so fail closed instead of scanning
  # the wrong tree — which would otherwise ship a stale non-HEAD branch, or
  # spuriously block a truthful push when the worktree carries unrelated work.
  head=$(git -C "$REPO_ROOT" rev-parse HEAD 2>/dev/null || echo none)

  while IFS=$'\t' read -r local_sha remote_sha; do
    [ -n "$local_sha" ] || continue
    [ "$local_sha" = "$ZERO_SHA" ] && continue
    ref_needs_scan=0
    if [ -n "$remote_sha" ] && [ "$remote_sha" != "$ZERO_SHA" ] \
       && git -C "$REPO_ROOT" cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
      changed=$(git -C "$REPO_ROOT" diff --name-only "$remote_sha" "$local_sha" 2>/dev/null || true)
      # The trigger must track the scanner's real truth inputs, not just .ts/.tsx:
      #   - source extensions: the walk seeds from BUILT_IN_SOURCE_EXTENSIONS in
      #     scripts/drift-ai/scope.ts, so --check-baseline scans .js/.jsx/.mjs/.cjs
      #     too — the committed baseline already lists eslint-rules/*.js pairs;
      #   - config: drift-ai.config.json feeds thresholds/exclusions, so a
      #     config-only push changes detector truth without touching any source.
      # musi_pre_push_load_scope_trigger sourced that ERE from the generated
      # fragment above, so it cannot drift from the scanner by hand.
      if grep -qE "$MUSI_PRE_PUSH_NEAR_DUPLICATES_TRIGGER" <<< "$changed"; then
        ref_needs_scan=1
      fi
    else
      # New branch or an unknown remote tip: the pushed range cannot be scoped
      # cheaply, so fall closed to a scan rather than risk shipping a stale
      # baseline. Pushes are rare, so an occasional unscoped scan is acceptable.
      ref_needs_scan=1
    fi

    [ "$ref_needs_scan" -eq 1 ] || continue

    if [ "$local_sha" != "$head" ]; then
      cat >&2 <<EOF
pre-push: near-duplicates boundary check can only validate the checked-out worktree (HEAD $head).
pre-push: you are pushing $local_sha, which is not HEAD, so the whole-tree baseline scan would
pre-push: examine the wrong tree. Check out the branch you are pushing (or push from its worktree),
pre-push: then retry so the scan validates the pushed tip.
EOF
      return 1
    fi

    need_scan=1
  done <<< "$updates"

  [ "$need_scan" -eq 1 ] || return 0

  if ! command -v bun >/dev/null 2>&1; then
    printf 'pre-push: near-duplicates boundary check skipped: bun is unavailable. Verify manually with bun run sensor:near-duplicates -- --check-baseline before integrating.\n' >&2
    return 0
  fi

  printf 'pre-push: near-duplicates whole-tree baseline boundary check running (--check-baseline)…\n' >&2
  check_output=$( (cd "$REPO_ROOT" && bun run sensor:near-duplicates -- --check-baseline) 2>&1 ) \
    || check_status=$?

  if [ "$check_status" -eq 0 ]; then
    printf 'pre-push: near-duplicates whole-tree baseline verified truthful.\n' >&2
    return 0
  fi

  # The near-duplicates --check-baseline verdict contract assigns exit 3 to a
  # stale baseline. Output is presentation only and never controls push policy.
  if [ "$check_status" -eq 3 ]; then
    cat >&2 <<EOF
pre-push: near-duplicates whole-tree baseline is STALE at the integration boundary.
pre-push: the committed sensor-near-duplicates.baseline.json does not match the assembled tree.
pre-push: read the verdict below for which identities drifted, then apply the matching fix:
  - New or increased clone (the usual integration case): refactor the shared decision flow
    away so the duplicate is gone, then re-run the check. --update refuses to grow the floor,
    so it will NOT clear new debt. If the duplication is reviewed and intended, admit it:
      bun run sensor:near-duplicates -- --admit <identity> --reason "<why it is intended>"
  - Only removals or decreases (a lane deleted code): shrink the committed floor:
      bun run sensor:near-duplicates -- --update
  - A semantic merge left a stale marker (marker present): restore the merge truth:
      bun scripts/sensor-near-duplicates.ts --restore-merge-truth
pre-push: commit the regenerated baseline before pushing.

Bypass caveat: git push --no-verify skips this local hook. Repository AI policy
blocks agent-issued push bypass attempts. Fix the baseline instead of bypassing.
EOF
    printf '%s\n' "$check_output" | tail -n 30 >&2
    return 1
  fi

  # Exit 6 is a separate verdict: the worktree baseline itself proposes debt
  # growth over committed HEAD, before the whole-tree truth comparison runs.
  if [ "$check_status" -eq 6 ]; then
    cat >&2 <<EOF
pre-push: near-duplicates working-tree baseline proposes unreviewed growth over HEAD.
pre-push: undo the baseline growth, remove the duplicate, or record the reviewed identity:
  bun run sensor:near-duplicates -- --admit <identity> --reason "<why it is intended>"
pre-push: commit the reviewed result before pushing.
EOF
    printf '%s\n' "$check_output" | tail -n 30 >&2
    return 1
  fi

  printf 'pre-push: near-duplicates boundary check could not run (exit %s); this is an environment failure, not a stale baseline, so the push is NOT blocked. Inspect the output below and re-run bun run sensor:near-duplicates -- --check-baseline once the environment is fixed.\n' \
    "$check_status" >&2
  printf '%s\n' "$check_output" | tail -n 20 >&2
  return 0
}

# git delivers the push ref updates on stdin; capture them once (preserving the
# empty-input case exactly) so both the fast-commit backstop and the
# near-duplicates boundary check see the same updates.
push_input=$(cat && printf x) || push_input=""
push_input=${push_input%x}
push_updates=$(printf '%s' "$push_input" | musi_pre_push_ref_updates)

musi_pre_push_main "$push_updates" || exit $?
musi_pre_push_near_duplicates_boundary "$push_updates"
