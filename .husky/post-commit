#!/bin/bash
# Finalize fast-commit provenance. pre-commit cannot know the commit SHA because
# Git creates it after that hook exits, so it leaves a pending marker for this
# post-commit hook to convert into the committed HEAD.

if [ -z "${BASH_VERSION:-}" ]; then
  exec bash "$0" "$@"
fi

set -u

REPO_ROOT="$(git rev-parse --show-toplevel)"

# shellcheck source=/dev/null
. "$REPO_ROOT/scripts/lib/verify-metadata.sh"

musi_post_commit_fast_pending() {
  printf '%s/musi-fast-commit-pending' "$(musi_git_common_identity_path "$REPO_ROOT")"
}

musi_post_commit_fast_log() {
  printf '%s/musi-fast-commit-log' "$(musi_git_common_identity_path "$REPO_ROOT")"
}

musi_post_commit_main() {
  local pending log head

  pending=$(musi_post_commit_fast_pending)
  [ -f "$pending" ] || return 0

  log=$(musi_post_commit_fast_log)
  head=$(git -C "$REPO_ROOT" rev-parse HEAD 2>/dev/null || true)
  [ -n "$head" ] || return 0

  mkdir -p "$(dirname "$log")"
  if [ ! -f "$log" ] || ! grep -qxF "$head" "$log"; then
    printf '%s\n' "$head" >> "$log"
  fi
  rm -f "$pending"
}

musi_post_commit_main "$@"
