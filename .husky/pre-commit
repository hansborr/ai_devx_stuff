#!/bin/bash
# ----------------------------------------------------------------------------
# Pre-commit gate. Runs changed-file checks and global drift checks IN PARALLEL.
#
# Why parallel: pre-commit and `verify:changed` / `verify:parallel` all run
# checks in parallel to stay inside the interactive budget. Only full manual
# `verify` (no flags) is sequential so a human or AI can act on one failure
# at a time.
#
# Design:
#   - `flock` keeps this to a single writer. Contention message embeds the
#     exact Monitor-wait incantation so the contending Claude session
#     doesn't fall into a log-polling loop.
#   - Last-verified marker (120s, keyed on HEAD + staged/relevant-input hash)
#     short-circuits the "re-run just to double-check" reflex. After that
#     misses, a fresh matching manual verify marker may bridge when its
#     worktree fingerprint proves the same state was already checked.
#   - 240s watchdog keeps the git-invoked gate inside the interactive command
#     budget. On timeout
#     the gate fails closed and prints log paths plus a `verify:logs budget`
#     pointer; no success marker is written.
#   - Per-task logs at $LOG_DIR/<task>.log; Passed/Failed status lines let
#     .claude/hooks/git-commit-quiet.sh surface only the failing tails.
#
# Bypass: set FORCE_VERIFY=1 to skip all last-verified short-circuits.
# The PreToolUse hook in .claude/settings.json blocks --no-verify / HUSKY=0
# bypasses entirely; fix issues, do not skip.
# ----------------------------------------------------------------------------
if [ -z "${BASH_VERSION:-}" ]; then
  exec bash "$0" "$@"
fi

set -u

REPO_ROOT="$(git rev-parse --show-toplevel)"
# shellcheck source=/dev/null
. "$REPO_ROOT/scripts/dependency-freshness.sh"
# shellcheck source=/dev/null
. "$REPO_ROOT/scripts/prisma-client-freshness.sh"
# shellcheck source=/dev/null
. "$REPO_ROOT/scripts/doc-length-policy.sh"
# shellcheck source=/dev/null
. "$REPO_ROOT/scripts/ai-hooks/output-filter.sh"
# shellcheck source=/dev/null
. "$REPO_ROOT/scripts/lib/verify-metadata.sh"
# shellcheck source=/dev/null
. "$REPO_ROOT/scripts/process-tree.sh"
# shellcheck source=/dev/null
. "$REPO_ROOT/scripts/lib/parallel-step.sh"
# shellcheck source=/dev/null
. "$REPO_ROOT/scripts/lib/lint-dist-preflight.sh"

warn_if_staged_lockfile_needs_install() {
  if ! git diff --cached --name-only --diff-filter=ACMR \
       | grep -qx 'bun.lock'; then
    return 0
  fi

  status="$(musi_dependency_status "$REPO_ROOT")"
  message="$(musi_dependency_message "$REPO_ROOT")"

  case "$status" in
    missing|stale)
      printf 'pre-commit: WARN: bun.lock is staged and install state appears stale: %s\n' "$message" >&2
      ;;
  esac
}

warn_if_staged_schema_needs_generate() {
  if ! git diff --cached --name-only --diff-filter=ACMR \
       | grep -qx 'packages/server/prisma/schema.prisma'; then
    return 0
  fi

  local result status message
  result="$(musi_prisma_client_freshness "$REPO_ROOT")"
  status="${result%%$'\t'*}"
  message="${result#*$'\t'}"

  case "$status" in
    missing|stale)
      printf 'pre-commit: WARN: schema.prisma is staged and generated client appears stale: %s\n' "$message" >&2
      ;;
  esac
}

warn_if_staged_hot_doc_too_long() {
  local staged file advisory lines
  staged="$(git diff --cached --name-only --diff-filter=ACMR)"
  [ -n "$staged" ] || return 0

  printf '%s\n' "$staged" | while IFS= read -r file; do
    [ -n "$file" ] || continue
    if ! musi_doc_length_set_rule "$REPO_ROOT/$file"; then
      continue
    fi
    lines="$(git show ":$file" 2>/dev/null | wc -l)"
    advisory="$(musi_doc_length_advisory_for_count "$REPO_ROOT/$file" "$lines" || true)"
    if [ -n "$advisory" ]; then
      printf 'pre-commit: WARN: %s\n' "$advisory" >&2
    fi
  done
}

warn_if_generated_surface_stale() {
  local label="$1" script="$2" output

  if output="$(bun run "$script" 2>&1)"; then
    return 0
  fi

  printf 'pre-commit: WARN: %s appears stale:\n%s\n' "$label" "$output" >&2
}

warn_if_generated_harness_surfaces_stale() {
  local staged generated_pattern
  staged="$(git diff --cached --name-only --diff-filter=ACMR)"
  [ -n "$staged" ] || return 0

  generated_pattern='^(harness\.controls\.json|scripts/harness/(generate-(hook-wiring|verify-steps)\.ts|hook-wiring-schema\.ts|verify-step-schema\.ts)|scripts/verify/steps\.generated\.sh|\.claude/settings\.json|\.codex/hooks\.json)$'
  if ! printf '%s\n' "$staged" | grep -Eq "$generated_pattern"; then
    return 0
  fi

  warn_if_generated_surface_stale "verify step metadata" "verify:steps:check"
  warn_if_generated_surface_stale "AI hook wiring" "harness:wiring:check"
}

warn_if_staged_lockfile_needs_install
warn_if_staged_schema_needs_generate
warn_if_staged_hot_doc_too_long
warn_if_generated_harness_surfaces_stale

# --- 1. Skip when nothing source-relevant is staged ------------------------
# Changed gates verify staged content. Reject source-relevant unstaged or
# untracked files before marker reuse or source-skip decisions.
musi_changed_gate_fail_if_unstaged "$REPO_ROOT" "pre-commit" || exit 1

# Include D here so pure staged deletions still run typecheck/test gates. The
# advisory freshness/doc filters above keep their narrower behavior.
staged_source_rc=0
musi_staged_has_source_relevant_change || staged_source_rc=$?
if [ "$staged_source_rc" -eq 1 ]; then
  echo "pre-commit: no source changes staged — skipping checks."
  exit 0
fi
if [ "$staged_source_rc" -ne 0 ]; then
  exit "$staged_source_rc"
fi

# --- 2. Non-blocking lock --------------------------------------------------
LOCK="${MUSI_VERIFY_LOCK:-/tmp/musi-pre-commit.lock}"
exec 9<>"$LOCK"
if ! flock -n 9; then
  HOLDER=$(cat "$LOCK" 2>/dev/null || true)
  cat >&2 <<EOF
=== PRE-COMMIT ALREADY RUNNING ===
${HOLDER:-<holder info unavailable>}

Another pre-commit is in progress. Do NOT re-run git commit — it will
fail here again and waste tokens on repeated polling.

To wait for the in-progress run WITHOUT polling, launch this command in
the background and attach the Monitor tool to its output. It blocks
until the lock releases, then prints exactly one line ("FREE"), which
Monitor reports as a single notification:

  flock /tmp/musi-pre-commit.lock true && echo FREE

When Monitor tells you "FREE" appeared, retry git commit once. If the
original run failed, its summary is already in the earlier tool output.
EOF
  exit 2
fi

# Record holder info (readable by any contender via plain cat).
{ printf 'PID=%s STARTED=%s\n' "$$" "$(date -Iseconds)"; } > "$LOCK"

# --- 3. Last-verified short-circuit ----------------------------------------
MARKER="${MUSI_PRECOMMIT_MARKER:-/tmp/musi-pre-commit-last}"
if [ -f "$MARKER" ] && [ "${FORCE_VERIFY:-}" != "1" ]; then
  CUR_HEAD=$(git rev-parse HEAD 2>/dev/null || echo none)
  CUR_HASH=$(ai_precommit_fingerprint "$REPO_ROOT")
  if musi_success_marker_matches "$MARKER" "$CUR_HEAD" "$CUR_HASH" 120; then
    echo "pre-commit: already verified ${MUSI_MARKER_MATCH_AGE}s ago at $CUR_HEAD — skipping (set FORCE_VERIFY=1 to re-run)."
    exit 0
  fi
fi

# Manual verify is a strict superset of the changed checks here: full verify
# covers lint/ratchet/zero-baseline/test/scripts, verify:changed covers
# lint:changed/lint:ratchet/zero-baseline/test:changed/test:scripts:changed,
# and typecheck is identical.
# Pre-commit only runs test:scripts:changed when staged hook/script paths
# match (or when harness.controls.json / lint-ratchet.baseline.json change —
# see the regex below), so either manual marker also covers that optional
# step.
if musi_try_verify_marker_bridge "$REPO_ROOT" "$MARKER" 120; then
  exit 0
fi

# --- 4. Watchdog (_over_ Claude's session-cache budget) ---------------------
# Keep the default under the interactive cache budget. `MUSI_VERIFY_TIMEOUT`
# stays as a back-compat override; new callers should set
# `MUSI_INTERACTIVE_TIMEOUT` / `MUSI_INTERACTIVE_WARN_AFTER`.
TIMEOUT="${MUSI_VERIFY_TIMEOUT:-${MUSI_INTERACTIVE_TIMEOUT:-240}}"
WARN_AFTER="${MUSI_INTERACTIVE_WARN_AFTER:-210}"
HOOK_PID=$$
(
  # Close FD 9 so our `sleep` child doesn't inherit the flock — otherwise
  # if we're killed before sleep finishes, sleep orphans to init still
  # holding the lock, blocking the next commit until TIMEOUT elapses.
  exec 9<&-
  SLEEP_PID=""
  trap '[ -n "$SLEEP_PID" ] && kill "$SLEEP_PID" 2>/dev/null; exit 0' TERM INT
  sleep "$TIMEOUT" &
  SLEEP_PID=$!
  wait "$SLEEP_PID"
  echo "" >&2
  echo "=== PRE-COMMIT TIMED OUT (${TIMEOUT}s) ===" >&2
  kill -TERM "$HOOK_PID" 2>/dev/null
) &
WD=$!

# --- 5. Parallel tasks -----------------------------------------------------
LOG_DIR="${MUSI_VERIFY_LOG_DIR:-/tmp/musi-pre-commit-logs}"
HISTORY_DIR="${MUSI_VERIFY_HISTORY_DIR:-/tmp/musi-verify-history}"
rm -rf "$LOG_DIR"
mkdir -p "$LOG_DIR" "$LOG_DIR/meta"
# shellcheck disable=SC2034 # Consumed by scripts/verify/steps.generated.sh.
TIMINGS_FILE="$LOG_DIR/test-timings.json"
META_DIR="$LOG_DIR/meta"
# shellcheck source=/dev/null
. "$REPO_ROOT/scripts/verify/steps.generated.sh"
# shellcheck source=/dev/null
. "$REPO_ROOT/scripts/verify/steps-lib.sh"

# Wrapper-meta breadcrumbs read by ai_stop_verify_status to decide whether the
# cached run-meta still describes the source/config state pre-commit checked.
META_HEAD=$(git rev-parse HEAD 2>/dev/null || echo none)
META_FP=$(ai_precommit_fingerprint "$REPO_ROOT")

START_TS=$(date +%s)
START_TIME=$(date -Iseconds)

PARALLEL_PIDS=()
STEP_NAMES=()
STEP_PIDS=()
STEP_EXITS=()
PENDING_LINT_CMD=()
DEFER_LINT=0
PENDING_LINT_INDEX=-1
TYPECHECK_INDEX=-1

if ! musi_lint_dist_outputs_present "$REPO_ROOT"; then
  DEFER_LINT=1
fi

for slot in "${MUSI_PRE_COMMIT_STEPS[@]}"; do
  resolve_rc=0
  musi_resolve_slot_cmd pre_commit "$slot" || resolve_rc=$?
  if [ "$resolve_rc" -eq "$MUSI_VERIFY_SLOT_SKIP_RC" ]; then
    continue
  fi
  if [ "$resolve_rc" -ne 0 ]; then
    printf 'pre-commit: failed to resolve %s step (rc=%s)\n' \
      "$slot" "$resolve_rc" > "$LOG_DIR/${slot}.log"
    STEP_NAMES+=("$slot")
    STEP_PIDS+=("")
    STEP_EXITS+=("$resolve_rc")
    break
  fi
  if [ "$DEFER_LINT" -eq 1 ] && [ "$slot" = lint ]; then
    PENDING_LINT_INDEX="${#STEP_NAMES[@]}"
    PENDING_LINT_CMD=("${MUSI_RESOLVED_SLOT_CMD[@]}")
    STEP_NAMES+=("$slot")
    STEP_PIDS+=("")
    STEP_EXITS+=("")
    continue
  fi
  musi_run_parallel_step parallel-precommit "" "$slot" "${MUSI_RESOLVED_SLOT_CMD[@]}"
  STEP_NAMES+=("$slot")
  STEP_PIDS+=("$STEP_PID")
  STEP_EXITS+=("")
  PARALLEL_PIDS+=("$STEP_PID")
  if [ "$slot" = typecheck ]; then
    TYPECHECK_INDEX=$(( ${#STEP_NAMES[@]} - 1 ))
  fi
done

# Propagate INT/TERM to children. Split traps to emit conventional exit codes:
#   INT  (Ctrl-C) → 130
#   TERM (watchdog timeout or external kill) → 124 (GNU `timeout` convention)
report_timeout_budget() {
  printf 'Timed out and stopped the verification process tree.\n' >&2
  printf 'For deliberate long verification, use bun run verify:async[:changed] and check bun run verify:async:status.\n' >&2
  printf 'logs: %s\n' "$LOG_DIR" >&2
  printf 'inspect: bun run verify:logs budget\n' >&2
}
cleanup_parallel_children() {
  local pid
  for pid in "${PARALLEL_PIDS[@]}"; do
    [ -n "$pid" ] && musi_signal_process_tree "$pid" TERM
  done
  kill "$WD" 2>/dev/null
}
write_signal_wrapper_meta() {
  exit_code="$1"
  end_ts=$(date +%s)
  end_time=$(date -Iseconds)
  musi_write_wrapper_meta "$META_DIR/wrapper.json" parallel-precommit \
    "$START_TS" "$START_TIME" "$end_ts" "$end_time" "$exit_code" "$0" \
    "$META_HEAD" "$META_FP"
  musi_combine_run_meta "$LOG_DIR" parallel-precommit "$META_DIR/wrapper.json"
  musi_persist_run_meta_history "$LOG_DIR" "$HISTORY_DIR"
}
trap 'cleanup_parallel_children; write_signal_wrapper_meta 130; exit 130' INT
trap 'cleanup_parallel_children; write_signal_wrapper_meta 124; report_timeout_budget; exit 124' TERM
trap 'kill $WD 2>/dev/null' EXIT

if [ "$PENDING_LINT_INDEX" -ge 0 ]; then
  if [ "$TYPECHECK_INDEX" -ge 0 ] && [ -n "${STEP_PIDS[$TYPECHECK_INDEX]}" ]; then
    pid="${STEP_PIDS[$TYPECHECK_INDEX]}"
    if wait "$pid"; then
      STEP_EXITS[$TYPECHECK_INDEX]=0
    else
      STEP_EXITS[$TYPECHECK_INDEX]=$?
    fi
    if [ "${STEP_EXITS[$TYPECHECK_INDEX]}" -eq 0 ]; then
      musi_run_parallel_step parallel-precommit "" lint "${PENDING_LINT_CMD[@]}"
      STEP_PIDS[$PENDING_LINT_INDEX]="$STEP_PID"
      PARALLEL_PIDS+=("$STEP_PID")
    else
      printf 'pre-commit: skipped lint because typecheck failed before required dist outputs were available\n' \
        > "$LOG_DIR/lint.log"
      STEP_EXITS[$PENDING_LINT_INDEX]=1
    fi
  else
    musi_run_parallel_step parallel-precommit "" lint "${PENDING_LINT_CMD[@]}"
    STEP_PIDS[$PENDING_LINT_INDEX]="$STEP_PID"
    PARALLEL_PIDS+=("$STEP_PID")
  fi
fi

for index in "${!STEP_NAMES[@]}"; do
  [ -n "${STEP_EXITS[$index]}" ] && continue
  pid="${STEP_PIDS[$index]}"
  [ -n "$pid" ] || continue
  if wait "$pid"; then
    STEP_EXITS[$index]=0
  else
    STEP_EXITS[$index]=$?
  fi
done
PARALLEL_PIDS=()

# --- 6. Aggregate results --------------------------------------------------
passed=""; failed=""
for index in "${!STEP_NAMES[@]}"; do
  task="${STEP_NAMES[$index]}"
  exit_code="${STEP_EXITS[$index]}"
  [ -n "$exit_code" ] || exit_code=1
  [ "$exit_code" -eq 0 ] && passed="$passed $task" || failed="$failed $task"
done

ELAPSED=$(( $(date +%s) - START_TS ))
END_TS=$(date +%s)
END_TIME=$(date -Iseconds)

if [ -n "$failed" ]; then
  musi_write_wrapper_meta "$META_DIR/wrapper.json" parallel-precommit \
    "$START_TS" "$START_TIME" "$END_TS" "$END_TIME" 1 "$0" \
    "$META_HEAD" "$META_FP"
  musi_combine_run_meta "$LOG_DIR" parallel-precommit "$META_DIR/wrapper.json"
  musi_persist_run_meta_history "$LOG_DIR" "$HISTORY_DIR"
  # Structured lines — git-commit-quiet.sh parses these.
  echo ""
  echo "=== PRE-COMMIT FAILED (${ELAPSED}s) ==="
  echo "Passed:$passed"
  echo "Failed:$failed"
  for task in $failed; do
    echo ""
    echo "--- $task (full log: $LOG_DIR/${task}.log) ---"
    if [ "$task" = ratchet ]; then
      ai_ratchet_failure_excerpt "$LOG_DIR/ratchet-diagnostics.json" "$LOG_DIR/${task}.log" 30
    else
      ai_filtered_task_log_excerpt "$task" "$LOG_DIR/${task}.log" 30
    fi
  done
  case "$failed" in
    *lint*) echo ""; echo "Hint: try 'bun run lint:fix' to auto-fix formatting issues." ;;
  esac
  case "$failed" in
    *format-check*) echo ""; echo "Hint: run 'bun run format:changed' to apply Prettier to changed files, or 'bun run format' for the full tree." ;;
  esac
  exit 1
fi

musi_write_wrapper_meta "$META_DIR/wrapper.json" parallel-precommit \
  "$START_TS" "$START_TIME" "$END_TS" "$END_TIME" 0 "$0" \
  "$META_HEAD" "$META_FP"
musi_combine_run_meta "$LOG_DIR" parallel-precommit "$META_DIR/wrapper.json"
musi_persist_run_meta_history "$LOG_DIR" "$HISTORY_DIR"

# --- 7. Success marker -----------------------------------------------------
if ! musi_write_success_marker "$MARKER" \
    "$(git rev-parse HEAD 2>/dev/null || echo none)" \
    "$(ai_precommit_fingerprint "$REPO_ROOT")"; then
  printf 'pre-commit: WARN: failed to write marker %s\n' "$MARKER" >&2
fi

if [ "$ELAPSED" -gt "$WARN_AFTER" ]; then
  printf 'pre-commit: WARN: elapsed=%ds exceeds soft budget %ds (hard=%ds). Inspect: bun run verify:logs budget\n' \
    "$ELAPSED" "$WARN_AFTER" "$TIMEOUT" >&2
fi

echo "pre-commit: OK (${ELAPSED}s) —$passed"
