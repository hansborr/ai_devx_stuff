#!/bin/bash
# ----------------------------------------------------------------------------
# Pre-commit gate. Runs changed-file checks and global drift checks IN PARALLEL.
#
# Why parallel: pre-commit and `verify:changed` / `verify:parallel` all run
# checks in parallel to stay inside the interactive budget. Only full manual
# `verify` (no flags) is sequential so a human or AI can act on one failure
# at a time.
#
# Design:
#   - `flock` keeps this to a single writer. Contention message embeds the
#     current lock holder so the contending session can wait without polling.
#   - Last-verified marker (MUSI_GATE_MARKER_FRESHNESS_SECONDS, keyed on HEAD +
#     staged/relevant-input hash) short-circuits the "re-run just to
#     double-check" reflex. After that misses, a fresh matching manual verify
#     marker may bridge when its worktree fingerprint proves the same state was
#     already checked.
#   - MUSI_GATE_INTERACTIVE_TIMEOUT_DEFAULT watchdog bounds the git-invoked gate. On timeout
#     the gate fails closed and prints log paths plus a `verify:logs budget`
#     pointer; no success marker is written.
#   - Per-task logs at $LOG_DIR/<task>.log; Passed/Failed status lines let
#     .claude/hooks/git-commit-quiet.sh surface only the failing tails.
#
# Protected branch: step 0 refuses direct commits on main/master (work lands
# there via merge, not direct commits). This is cwd-correct, so it also blocks
# the `git -C`/`cd` forms the PreToolUse matcher cannot see.
#
# Bypass: set FORCE_VERIFY=1 to skip all last-verified short-circuits.
# The PreToolUse hook in .claude/settings.json blocks --no-verify / HUSKY=0
# bypasses entirely; fix issues, do not skip.
# ----------------------------------------------------------------------------
if [ -z "${BASH_VERSION:-}" ]; then
  exec bash "$0" "$@"
fi

set -u

REPO_ROOT="$(git rev-parse --show-toplevel)"

# shellcheck source=/dev/null
. "$REPO_ROOT/scripts/lib/gate-env.sh"

# --- 0. Protected-branch guard ---------------------------------------------
# Refuse direct commits on the protected branch (main/master) before any other
# work; integrate via merge instead (git merge --no-ff skips this hook). git
# runs the hook inside the committing repo, so the check is cwd-correct and also
# catches the `git -C <path>` / `cd <path> && git commit` forms the PreToolUse
# string matcher cannot resolve.
#
# Soft source on purpose: policy.sh is always present in a real checkout, but
# the minimal pre-commit fixtures under scripts/tests/ copy only the pipeline
# libs they exercise and legitimately omit it — they don't test this guard,
# which has direct coverage via ai_guard_commit_branch_or_die in
# scripts/ai-hooks/test.sh.
if [ -f "$REPO_ROOT/scripts/ai-hooks/policy.sh" ]; then
  # shellcheck source=/dev/null
  . "$REPO_ROOT/scripts/ai-hooks/policy.sh"
  ai_guard_commit_branch_or_die || exit 1
fi

# shellcheck source=/dev/null
. "$REPO_ROOT/scripts/dependency-freshness.sh"
# shellcheck source=/dev/null
. "$REPO_ROOT/scripts/prisma-client-freshness.sh"
# shellcheck source=/dev/null
. "$REPO_ROOT/scripts/doc-length-policy.sh"
# shellcheck source=/dev/null
. "$REPO_ROOT/scripts/ai-hooks/output-filter.sh"
# shellcheck source=/dev/null
. "$REPO_ROOT/scripts/lib/verify-metadata.sh"
# shellcheck source=/dev/null
. "$REPO_ROOT/scripts/process-tree.sh"
# shellcheck source=/dev/null
. "$REPO_ROOT/scripts/lib/parallel-step.sh"
# shellcheck source=/dev/null
. "$REPO_ROOT/scripts/lib/lint-dist-preflight.sh"
# shellcheck source=/dev/null
. "$REPO_ROOT/scripts/verify/memory-wait-timeout.sh"
# shellcheck source=/dev/null
. "$REPO_ROOT/scripts/lib/verify-engine.sh"

FAST_COMMIT_RECORD_PENDING=0
FAST_COMMIT_PENDING_PRESERVE=0
MUSI_PRECOMMIT_ADMISSION_REACHABLE=0

musi_precommit_fast_marker() {
  printf '%s/musi-fast-commit' "$(musi_git_common_identity_path "$REPO_ROOT")"
}

musi_precommit_fast_pending() {
  musi_fast_commit_pending_marker "$REPO_ROOT"
}

musi_precommit_recover_fast_provenance() {
  local pending failed_heads failed_head parent current_head current_parent log

  pending=$(musi_precommit_fast_pending)
  [ -f "$pending" ] || return 0

  failed_heads=$(sed -n 's/^head=//p' "$pending" 2>/dev/null)
  if [ -z "$failed_heads" ]; then
    # Compatibility with markers written before post-commit learned to persist
    # the failed HEAD. At the immediately following pre-commit, the old marker's
    # parent is HEAD^1, so the skipped commit can still be recovered exactly.
    parent=$(sed -n 's/^parent=//p' "$pending" 2>/dev/null | tail -n 1)
    current_head=$(git -C "$REPO_ROOT" rev-parse HEAD 2>/dev/null || true)
    current_parent=$(git -C "$REPO_ROOT" rev-parse 'HEAD^1' 2>/dev/null || echo none)
    if { [ -n "$current_head" ] && [ "$parent" = "$current_head" ]; } \
       || { [ -z "$current_head" ] && [ "$parent" = none ]; }; then
      # pre-commit succeeded but the commit itself never materialized (for
      # example commit-msg rejected it). There is no skipped commit to recover.
      rm -f "$pending" || {
        FAST_COMMIT_PENDING_PRESERVE=1
        return 1
      }
      return 0
    elif [ -n "$current_head" ] && [ -n "$parent" ] && [ "$parent" = "$current_parent" ]; then
      failed_heads="$current_head"
    fi
  fi

  if [ -z "$failed_heads" ]; then
    FAST_COMMIT_PENDING_PRESERVE=1
    log=$(musi_fast_commit_log_path "$REPO_ROOT")
    printf 'pre-commit: ERROR: unresolved fast-commit pending marker %s; refusing to overwrite skipped-slot provenance\n' \
      "$pending" >&2
    printf 'pre-commit: RECOVERY: Append the skipped SHA(s) to %s, then remove %s\n' \
      "$log" "$pending" >&2
    return 1
  fi
  while IFS= read -r failed_head; do
    [ -n "$failed_head" ] || continue
    if ! musi_fast_commit_log_append "$REPO_ROOT" "$failed_head"; then
      FAST_COMMIT_PENDING_PRESERVE=1
      printf 'pre-commit: ERROR: failed to recover fast-commit provenance for %s from %s; refusing the new commit\n' \
        "$failed_head" "$pending" >&2
      return 1
    fi
  done <<< "$failed_heads"
  if ! rm -f "$pending"; then
    FAST_COMMIT_PENDING_PRESERVE=1
    printf 'pre-commit: ERROR: recovered fast-commit provenance but could not consume pending marker %s; refusing the new commit\n' \
      "$pending" >&2
    return 1
  fi
}

# FAST_COMMIT_RECORD_PENDING is bound to the under-lock fast-mode snapshot by
# musi_precommit_snapshot_fast_mode. Exit-0 paths that provably skip nothing
# (no source-relevant change; verify-marker bridge, whose markers come from
# manual verify / verify:changed which never fast-skip) leave or set it to zero,
# and the parallel run replaces it with the actual slot-resolution outcome
# (MUSI_FAST_COMMIT_SKIPPED, set inside musi_resolve_slot_cmd's fast-commit
# arm). The marker short-circuit path deliberately keeps the snapshot value:
# the reused
# success marker may have been stamped by a slot-skipping run whose commit
# then failed (e.g. commit-msg) and is being retried within the freshness
# window — recording nothing there would let real test debt escape the
# pre-push backstop.
musi_precommit_prepare_fast_provenance() {
  musi_precommit_recover_fast_provenance || return 1
  FAST_COMMIT_RECORD_PENDING=0
}

musi_precommit_fast_provenance_on_exit() {
  local exit_code="$1"
  local pending

  pending=$(musi_precommit_fast_pending)
  if [ "$FAST_COMMIT_PENDING_PRESERVE" -eq 1 ]; then
    return 0
  fi
  if [ "$exit_code" -eq 0 ] && [ "$FAST_COMMIT_RECORD_PENDING" -eq 1 ]; then
    mkdir -p "$(dirname "$pending")"
    {
      printf 'worktree=%s\n' "$REPO_ROOT"
      printf 'parent=%s\n' "$(git -C "$REPO_ROOT" rev-parse HEAD 2>/dev/null || echo none)"
      printf 'time=%s\n' "$(date -Iseconds)"
    } > "$pending" || printf 'pre-commit: WARN: failed to record fast-commit pending marker %s\n' "$pending" >&2
  else
    rm -f "$pending"
  fi
}

musi_verify_install_exit_dispatcher musi_precommit_fast_provenance_on_exit || exit 2

warn_if_staged_lockfile_needs_install() {
  if ! git diff --cached --name-only --diff-filter=ACMR \
       | grep -qx 'bun.lock'; then
    return 0
  fi

  status="$(musi_dependency_status "$REPO_ROOT")"
  message="$(musi_dependency_message "$REPO_ROOT")"

  case "$status" in
    missing|stale)
      printf 'pre-commit: WARN: bun.lock is staged and install state appears stale: %s\n' "$message" >&2
      ;;
  esac
}

warn_if_staged_schema_needs_generate() {
  if ! git diff --cached --name-only --diff-filter=ACMR \
       | grep -qx 'packages/server/prisma/schema.prisma'; then
    return 0
  fi

  local result status message
  result="$(musi_prisma_client_freshness "$REPO_ROOT")"
  status="${result%%$'\t'*}"
  message="${result#*$'\t'}"

  case "$status" in
    missing|stale)
      printf 'pre-commit: WARN: schema.prisma is staged and generated client appears stale: %s\n' "$message" >&2
      ;;
  esac
}

warn_if_staged_hot_doc_too_long() {
  local staged file advisory lines
  staged="$(git diff --cached --name-only --diff-filter=ACMR)"
  [ -n "$staged" ] || return 0

  printf '%s\n' "$staged" | while IFS= read -r file; do
    [ -n "$file" ] || continue
    if ! musi_doc_length_set_rule "$REPO_ROOT/$file"; then
      continue
    fi
    lines="$(git show ":$file" 2>/dev/null | wc -l)"
    advisory="$(musi_doc_length_advisory_for_count "$REPO_ROOT/$file" "$lines" || true)"
    if [ -n "$advisory" ]; then
      printf 'pre-commit: WARN: %s\n' "$advisory" >&2
    fi
  done
}

warn_if_generated_surface_stale() {
  local label="$1" script="$2" output

  if [ "$MUSI_PRECOMMIT_ADMISSION_REACHABLE" -eq 1 ] \
     && [ "${MUSI_FAST_COMMIT_ENABLED_SNAPSHOT:-0}" -eq 1 ]; then
    case "$script" in
      harness:skills:check|test:scripts:subjects:check|verify:steps:check) return 0 ;;
    esac
  fi

  if output="$(bun run "$script" 2>&1)"; then
    return 0
  fi

  printf 'pre-commit: WARN: %s appears stale:\n%s\n' "$label" "$output" >&2
}

FRESHNESS_FRAGMENT="$REPO_ROOT/scripts/harness/generated-surface-freshness.generated.sh"
if [ -f "$FRESHNESS_FRAGMENT" ]; then
  # shellcheck source=../scripts/harness/generated-surface-freshness.generated.sh
  . "$FRESHNESS_FRAGMENT"
else
  # Advisory-only layer: warn (do not block) so a missing/unregenerated fragment
  # does not silently drop the staleness nudges. harness:check remains the
  # fail-closed backstop for the generated surfaces themselves.
  printf 'pre-commit: WARN: %s missing; generated-surface staleness advisories skipped (run bun run verify:steps).\n' \
    "$FRESHNESS_FRAGMENT" >&2
fi

warn_if_staged_lockfile_needs_install
warn_if_staged_schema_needs_generate
warn_if_staged_hot_doc_too_long
musi_precommit_prepare_fast_provenance || exit 1

# Attribute a mid-session fast-commit marker vanish: log any presence flip since
# the last commit observed it. Never blocks the commit.
musi_fast_commit_marker_observe "$REPO_ROOT" || true

# --- 1. Skip when nothing source-relevant is staged ------------------------
# Changed gates verify staged content. Reject source-relevant unstaged or
# untracked files before marker reuse or source-skip decisions.
musi_changed_gate_fail_if_unstaged "$REPO_ROOT" "pre-commit" || exit 1

# Reject hidden binary bytes in the exact source blobs this commit would record
# before source-skip or marker shortcuts can admit them.
musi_staged_source_blobs_reject_nul || exit $?

# Include D here so pure staged deletions still run typecheck/test gates. The
# advisory freshness/doc filters above keep their narrower behavior.
staged_source_rc=0
musi_staged_has_source_relevant_change || staged_source_rc=$?
if [ "$staged_source_rc" -eq 1 ]; then
  if declare -F musi_warn_generated_surfaces_stale >/dev/null 2>&1; then
    musi_warn_generated_surfaces_stale
  fi
  echo "pre-commit: no source changes staged — skipping checks."
  # Nothing ran, so nothing was fast-skipped: a docs-only commit carries no
  # test debt and must not be recorded in the fast-commit provenance log.
  FAST_COMMIT_RECORD_PENDING=0
  exit 0
fi
if [ "$staged_source_rc" -ne 0 ]; then
  exit "$staged_source_rc"
fi
MUSI_PRECOMMIT_ADMISSION_REACHABLE=1

MUSI_PRECOMMIT_REGISTRATION_TIMEOUT="${MUSI_PRECOMMIT_REGISTRATION_TIMEOUT:-$MUSI_GATE_PRECOMMIT_REGISTRATION_TIMEOUT_DEFAULT}"
case "$MUSI_PRECOMMIT_REGISTRATION_TIMEOUT" in
  '' | *[!0-9]* | 0*)
    printf 'pre-commit: invalid MUSI_PRECOMMIT_REGISTRATION_TIMEOUT=%s; expected positive whole seconds without a suffix or leading zero (for example, 30)\n' \
      "$MUSI_PRECOMMIT_REGISTRATION_TIMEOUT" >&2
    exit 2
    ;;
esac

# The cross-worktree commit queue remains held while slots run. Memory
# deferral therefore has its own short, hard deadline: fail with a retryable
# diagnostic instead of blocking every sibling worktree behind this commit.
MUSI_VERIFY_MEMORY_WAIT_TIMEOUT="${MUSI_VERIFY_MEMORY_WAIT_TIMEOUT:-30}"
memory_wait_timeout_input="$MUSI_VERIFY_MEMORY_WAIT_TIMEOUT"
memory_wait_timeout_rc=0
MUSI_VERIFY_MEMORY_WAIT_TIMEOUT="$(
  musi_memory_wait_timeout_parse "$MUSI_VERIFY_MEMORY_WAIT_TIMEOUT" pre-commit
)" || memory_wait_timeout_rc=$?
[ "$memory_wait_timeout_rc" -eq 0 ] || exit "$memory_wait_timeout_rc"
# shellcheck disable=SC2071 # Equal-length decimal strings compare lexically before any integer parse.
if [ "${#MUSI_VERIFY_MEMORY_WAIT_TIMEOUT}" -gt 2 ] \
   || { [ "${#MUSI_VERIFY_MEMORY_WAIT_TIMEOUT}" -eq 2 ] \
        && [[ "$MUSI_VERIFY_MEMORY_WAIT_TIMEOUT" > 30 ]]; }; then
  printf 'pre-commit: MUSI_VERIFY_MEMORY_WAIT_TIMEOUT=%s exceeds the 30-second pre-commit memory-wait cap; using 30\n' \
    "$memory_wait_timeout_input" >&2
  MUSI_VERIFY_MEMORY_WAIT_TIMEOUT=30
fi
unset memory_wait_timeout_input memory_wait_timeout_rc
export MUSI_VERIFY_MEMORY_WAIT_TIMEOUT

LOCK="${MUSI_VERIFY_LOCK:-$(musi_standard_verify_lock "$REPO_ROOT")}"
COMMIT_QUEUE_LOCK="${MUSI_COMMIT_QUEUE_LOCK:-$(musi_standard_commit_queue_lock "$REPO_ROOT")}"
TOTAL_TIMEOUT="${MUSI_INTERACTIVE_TIMEOUT:-$MUSI_GATE_INTERACTIVE_TIMEOUT_DEFAULT}"
COMMIT_QUEUE_TIMEOUT="${MUSI_COMMIT_QUEUE_TIMEOUT:-$TOTAL_TIMEOUT}"
WARN_AFTER="${MUSI_INTERACTIVE_WARN_AFTER:-1080}"
MARKER="${MUSI_PRECOMMIT_MARKER:-$(musi_standard_precommit_marker "$REPO_ROOT")}"
HISTORY_DIR="${MUSI_VERIFY_HISTORY_DIR:-$(musi_standard_verify_history_dir "$REPO_ROOT")}"
LOG_DIR="${MUSI_VERIFY_LOG_DIR:-$(musi_standard_verify_log_dir "$REPO_ROOT")}"
# shellcheck disable=SC2034 # Consumed by scripts/verify/steps.generated.sh.
TIMINGS_FILE="$LOG_DIR/test-timings.json"
# shellcheck disable=SC2034 # Consumed by scripts/lib/parallel-step.sh.
META_DIR="$LOG_DIR/meta"

musi_precommit_head() {
  git rev-parse HEAD 2>/dev/null || echo none
}

musi_precommit_cache_fingerprint() {
  musi_require_fingerprint "pre-commit cache" ai_precommit_fingerprint "$REPO_ROOT"
}

musi_precommit_run_fingerprint() {
  musi_require_fingerprint "pre-commit metadata" ai_precommit_fingerprint "$REPO_ROOT"
}

musi_precommit_final_fingerprint() {
  musi_require_fingerprint "pre-commit finalize" ai_precommit_fingerprint "$REPO_ROOT"
}

musi_precommit_registration_admission() {
  timeout --foreground --signal=TERM --kill-after=1s \
    "${MUSI_PRECOMMIT_REGISTRATION_TIMEOUT}s" \
    bun run harness:registration:check
}

# shellcheck disable=SC2034 # Read later by fingerprint and slot-resolution helpers.
musi_precommit_snapshot_fast_mode() {
  local snapshot_rc
  if [ -f "$(musi_precommit_fast_marker)" ]; then
    MUSI_FAST_COMMIT_ENABLED_SNAPSHOT=1
    FAST_COMMIT_RECORD_PENDING=1
    snapshot_rc=0
  else
    MUSI_FAST_COMMIT_ENABLED_SNAPSHOT=0
    FAST_COMMIT_RECORD_PENDING=0
    snapshot_rc=1
  fi
  # Source-relevant generated-surface advisories run after lock acquisition
  # and consume this authoritative snapshot. Docs-only commits never enter the
  # gate and retain their earlier advisory path with suppression disabled.
  if [ "$MUSI_PRECOMMIT_ADMISSION_REACHABLE" -eq 1 ] \
     && declare -F musi_warn_generated_surfaces_stale >/dev/null 2>&1; then
    musi_warn_generated_surfaces_stale || true
  fi
  return "$snapshot_rc"
}

musi_precommit_marker_hit() {
  echo "pre-commit: already verified ${MUSI_MARKER_MATCH_AGE}s ago at $MUSI_VERIFY_GATE_CACHE_HEAD — skipping (set FORCE_VERIFY=1 to re-run)."
  musi_record_precommit_shortcircuit "$HISTORY_DIR" precommit-marker \
    "$MUSI_VERIFY_GATE_CACHE_HEAD" "$MUSI_VERIFY_GATE_CACHE_FINGERPRINT" \
    precommit-marker
}

# Predicate outcomes are part of the engine contract: 0=hit, 1=ordinary miss,
# 2=operational failure. A failed fingerprint or marker write may not be hidden
# as a cache miss that silently proceeds to expensive slots.
musi_precommit_verify_bridge() {
  local bridge_rc=0
  musi_try_verify_marker_bridge "$REPO_ROOT" "$MARKER" \
    "$MUSI_GATE_MARKER_FRESHNESS_SECONDS" || bridge_rc=$?
  case "$bridge_rc" in
    0)
      FAST_COMMIT_RECORD_PENDING=0
      musi_record_precommit_shortcircuit "$HISTORY_DIR" precommit-bridged \
        "${MUSI_VERIFY_BRIDGE_HEAD:-}" "${MUSI_VERIFY_BRIDGE_FINGERPRINT:-}" \
        "${MUSI_VERIFY_BRIDGE_KIND:-verify-bridge}"
      return 0
      ;;
    1) return 1 ;;
    *) return 2 ;;
  esac
}

musi_precommit_prepare_slots() {
  # shellcheck source=/dev/null
  . "$REPO_ROOT/scripts/verify/steps.generated.sh"
  # shellcheck source=/dev/null
  . "$REPO_ROOT/scripts/verify/steps-lib.sh"
}

musi_precommit_after_slots() {
  FAST_COMMIT_RECORD_PENDING="${MUSI_FAST_COMMIT_SKIPPED:-0}"
}

musi_precommit_success_mode() {
  if [ "${MUSI_FAST_COMMIT_SKIPPED:-0}" = 1 ]; then
    printf 'parallel-precommit-fast\n'
  else
    printf 'parallel-precommit\n'
  fi
}

REGISTRATION_ADMISSION_HOOK='musi_precommit_registration_admission'

# The generated arrays remain the authority. The hook visibly owns policy
# (including the protected-branch guard and 30-second memory-deferral cap),
# while verify-engine owns gate mechanics for C8's command-policy follow-up.
# shellcheck disable=SC2034 # Passed by name to musi_verify_run_gate.
declare -A PRECOMMIT_GATE_POLICY=(
  [label]='pre-commit'
  [banner_label]='PRE-COMMIT'
  [step_label]=''
  [wrapper_command]="$0"
  [repo_root]="$REPO_ROOT"
  [lock_mode]='nonblocking'
  [lock_path]="$LOCK"
  [lock_already_held]="${MUSI_VERIFY_LOCK_ALREADY_HELD:-0}"
  [commit_queue_mode]='blocking'
  [commit_queue_lock]="$COMMIT_QUEUE_LOCK"
  [commit_queue_already_held]="${MUSI_COMMIT_QUEUE_LOCK_ALREADY_HELD:-0}"
  [commit_queue_timeout]="$COMMIT_QUEUE_TIMEOUT"
  [total_timeout]="$TOTAL_TIMEOUT"
  [warn_after]="$WARN_AFTER"
  [marker_path]="$MARKER"
  [marker_freshness]="$MUSI_GATE_MARKER_FRESHNESS_SECONDS"
  [cache_head_provider]='musi_precommit_head'
  [cache_fingerprint_provider]='musi_precommit_cache_fingerprint'
  [run_head_provider]='musi_precommit_head'
  [run_fingerprint_provider]='musi_precommit_run_fingerprint'
  [final_fingerprint_provider]='musi_precommit_final_fingerprint'
  [marker_head_provider]='musi_precommit_head'
  [execution_mode]='parallel'
  [consumer]='pre_commit'
  [steps_array]='MUSI_PRE_COMMIT_STEPS'
  [signal_mode]='parallel-precommit'
  [failure_mode]='parallel-precommit'
  [success_mode_provider]='musi_precommit_success_mode'
  [log_dir]="$LOG_DIR"
  [history_dir]="$HISTORY_DIR"
  [marker_hit_hook]='musi_precommit_marker_hit'
  [marker_miss_hook]=''
  [pre_cache_admission_condition]='musi_precommit_snapshot_fast_mode'
  [pre_cache_admission_hook]="$REGISTRATION_ADMISSION_HOOK"
  [bridge_predicate]='musi_precommit_verify_bridge'
  [prepare_slots_hook]='musi_precommit_prepare_slots'
  [after_slots_hook]='musi_precommit_after_slots'
  [exit_hook]='musi_precommit_fast_provenance_on_exit'
)

musi_verify_run_gate PRECOMMIT_GATE_POLICY
