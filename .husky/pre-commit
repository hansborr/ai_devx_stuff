#!/bin/bash
# ----------------------------------------------------------------------------
# Pre-commit gate. Runs changed-file checks and global drift checks IN PARALLEL.
#
# Why parallel: pre-commit and `verify:changed` / `verify:parallel` all run
# checks in parallel to stay inside the interactive budget. Only full manual
# `verify` (no flags) is sequential so a human or AI can act on one failure
# at a time.
#
# Design:
#   - `flock` keeps this to a single writer. Contention message embeds the
#     current lock holder so the contending session can wait without polling.
#   - Last-verified marker (120s, keyed on HEAD + staged/relevant-input hash)
#     short-circuits the "re-run just to double-check" reflex. After that
#     misses, a fresh matching manual verify marker may bridge when its
#     worktree fingerprint proves the same state was already checked.
#   - 1200s watchdog bounds the git-invoked gate. On timeout
#     the gate fails closed and prints log paths plus a `verify:logs budget`
#     pointer; no success marker is written.
#   - Per-task logs at $LOG_DIR/<task>.log; Passed/Failed status lines let
#     .claude/hooks/git-commit-quiet.sh surface only the failing tails.
#
# Protected branch: step 0 refuses direct commits on main/master (work lands
# there via merge, not direct commits). This is cwd-correct, so it also blocks
# the `git -C`/`cd` forms the PreToolUse matcher cannot see.
#
# Bypass: set FORCE_VERIFY=1 to skip all last-verified short-circuits.
# The PreToolUse hook in .claude/settings.json blocks --no-verify / HUSKY=0
# bypasses entirely; fix issues, do not skip.
# ----------------------------------------------------------------------------
if [ -z "${BASH_VERSION:-}" ]; then
  exec bash "$0" "$@"
fi

set -u

REPO_ROOT="$(git rev-parse --show-toplevel)"

# shellcheck source=/dev/null
. "$REPO_ROOT/scripts/lib/gate-env.sh"

# --- 0. Protected-branch guard ---------------------------------------------
# Refuse direct commits on the protected branch (main/master) before any other
# work; integrate via merge instead (git merge --no-ff skips this hook). git
# runs the hook inside the committing repo, so the check is cwd-correct and also
# catches the `git -C <path>` / `cd <path> && git commit` forms the PreToolUse
# string matcher cannot resolve.
#
# Soft source on purpose: policy.sh is always present in a real checkout, but
# the minimal pre-commit fixtures under scripts/tests/ copy only the pipeline
# libs they exercise and legitimately omit it — they don't test this guard,
# which has direct coverage via ai_guard_commit_branch_or_die in
# scripts/ai-hooks/test.sh.
if [ -f "$REPO_ROOT/scripts/ai-hooks/policy.sh" ]; then
  # shellcheck source=/dev/null
  . "$REPO_ROOT/scripts/ai-hooks/policy.sh"
  ai_guard_commit_branch_or_die || exit 1
fi

# shellcheck source=/dev/null
. "$REPO_ROOT/scripts/dependency-freshness.sh"
# shellcheck source=/dev/null
. "$REPO_ROOT/scripts/prisma-client-freshness.sh"
# shellcheck source=/dev/null
. "$REPO_ROOT/scripts/doc-length-policy.sh"
# shellcheck source=/dev/null
. "$REPO_ROOT/scripts/ai-hooks/output-filter.sh"
# shellcheck source=/dev/null
. "$REPO_ROOT/scripts/lib/verify-metadata.sh"
# shellcheck source=/dev/null
. "$REPO_ROOT/scripts/process-tree.sh"
# shellcheck source=/dev/null
. "$REPO_ROOT/scripts/lib/parallel-step.sh"
# shellcheck source=/dev/null
. "$REPO_ROOT/scripts/lib/lint-dist-preflight.sh"
# shellcheck source=/dev/null
. "$REPO_ROOT/scripts/lib/verify-engine.sh"

FAST_COMMIT_RECORD_PENDING=0

musi_precommit_fast_marker() {
  printf '%s/musi-fast-commit' "$(musi_git_common_identity_path "$REPO_ROOT")"
}

musi_precommit_fast_pending() {
  printf '%s/musi-fast-commit-pending' "$(musi_git_common_identity_path "$REPO_ROOT")"
}

musi_precommit_prepare_fast_provenance() {
  local pending

  pending=$(musi_precommit_fast_pending)
  rm -f "$pending"
  if [ -f "$(musi_precommit_fast_marker)" ]; then
    FAST_COMMIT_RECORD_PENDING=1
  else
    FAST_COMMIT_RECORD_PENDING=0
  fi
}

musi_precommit_fast_provenance_on_exit() {
  local exit_code="$1"
  local pending

  pending=$(musi_precommit_fast_pending)
  if [ "$exit_code" -eq 0 ] && [ "$FAST_COMMIT_RECORD_PENDING" -eq 1 ]; then
    mkdir -p "$(dirname "$pending")"
    {
      printf 'worktree=%s\n' "$REPO_ROOT"
      printf 'parent=%s\n' "$(git -C "$REPO_ROOT" rev-parse HEAD 2>/dev/null || echo none)"
      printf 'time=%s\n' "$(date -Iseconds)"
    } > "$pending" || printf 'pre-commit: WARN: failed to record fast-commit pending marker %s\n' "$pending" >&2
  else
    rm -f "$pending"
  fi
}

trap 'musi_precommit_fast_provenance_on_exit "$?"' EXIT

warn_if_staged_lockfile_needs_install() {
  if ! git diff --cached --name-only --diff-filter=ACMR \
       | grep -qx 'bun.lock'; then
    return 0
  fi

  status="$(musi_dependency_status "$REPO_ROOT")"
  message="$(musi_dependency_message "$REPO_ROOT")"

  case "$status" in
    missing|stale)
      printf 'pre-commit: WARN: bun.lock is staged and install state appears stale: %s\n' "$message" >&2
      ;;
  esac
}

warn_if_staged_schema_needs_generate() {
  if ! git diff --cached --name-only --diff-filter=ACMR \
       | grep -qx 'packages/server/prisma/schema.prisma'; then
    return 0
  fi

  local result status message
  result="$(musi_prisma_client_freshness "$REPO_ROOT")"
  status="${result%%$'\t'*}"
  message="${result#*$'\t'}"

  case "$status" in
    missing|stale)
      printf 'pre-commit: WARN: schema.prisma is staged and generated client appears stale: %s\n' "$message" >&2
      ;;
  esac
}

warn_if_staged_hot_doc_too_long() {
  local staged file advisory lines
  staged="$(git diff --cached --name-only --diff-filter=ACMR)"
  [ -n "$staged" ] || return 0

  printf '%s\n' "$staged" | while IFS= read -r file; do
    [ -n "$file" ] || continue
    if ! musi_doc_length_set_rule "$REPO_ROOT/$file"; then
      continue
    fi
    lines="$(git show ":$file" 2>/dev/null | wc -l)"
    advisory="$(musi_doc_length_advisory_for_count "$REPO_ROOT/$file" "$lines" || true)"
    if [ -n "$advisory" ]; then
      printf 'pre-commit: WARN: %s\n' "$advisory" >&2
    fi
  done
}

warn_if_generated_surface_stale() {
  local label="$1" script="$2" output

  if output="$(bun run "$script" 2>&1)"; then
    return 0
  fi

  printf 'pre-commit: WARN: %s appears stale:\n%s\n' "$label" "$output" >&2
}

warn_if_generated_surfaces_stale() {
  local staged generated_pattern lint_guidance_pattern
  staged="$(git diff --cached --name-only --diff-filter=ACMR)"
  [ -n "$staged" ] || return 0

  generated_pattern='^(harness\.controls\.json|tsconfig\.configs\.json|eslint-config/(config-surface-manifest\.json|config-surfaces\.js)|scripts/harness/(generate-(hook-wiring|hook-timeout-constants|verify-steps|harness-controls|config-surfaces)\.ts|hook-timeout-constants\.ts|hook-wiring-schema\.ts|verify-step-schema\.ts)|scripts/ai-hooks/hook-timeouts\.generated\.sh|scripts/verify/steps\.generated\.sh|docs/generated/harness-controls\.md|\.claude/settings\.json|\.codex/hooks\.json|\.github/hooks/copilot\.json)$'
  lint_guidance_pattern='^(eslint-rules/.*|eslint-config/local-plugin\.js|scripts/generate-lint-guidance\.ts|scripts/lib/lint-rule-docs\.ts|docs/generated/local-lint-rules\.md)$'

  if printf '%s\n' "$staged" | grep -Eq "$generated_pattern"; then
    warn_if_generated_surface_stale "verify step metadata" "verify:steps:check"
    warn_if_generated_surface_stale "hook timeout constants" "harness:hook-timeouts:check"
    warn_if_generated_surface_stale "AI hook wiring" "harness:wiring:check"
    warn_if_generated_surface_stale "harness controls docs" "docs:harness-controls:check"
    warn_if_generated_surface_stale "config surface tsconfig" "harness:config-surfaces:check"
  fi

  if printf '%s\n' "$staged" | grep -Eq "$lint_guidance_pattern"; then
    warn_if_generated_surface_stale "lint guidance" "docs:lint-guidance:check"
  fi
}

warn_if_staged_lockfile_needs_install
warn_if_staged_schema_needs_generate
warn_if_staged_hot_doc_too_long
warn_if_generated_surfaces_stale

musi_precommit_prepare_fast_provenance

# --- 1. Skip when nothing source-relevant is staged ------------------------
# Changed gates verify staged content. Reject source-relevant unstaged or
# untracked files before marker reuse or source-skip decisions.
musi_changed_gate_fail_if_unstaged "$REPO_ROOT" "pre-commit" || exit 1

# Include D here so pure staged deletions still run typecheck/test gates. The
# advisory freshness/doc filters above keep their narrower behavior.
staged_source_rc=0
musi_staged_has_source_relevant_change || staged_source_rc=$?
if [ "$staged_source_rc" -eq 1 ]; then
  echo "pre-commit: no source changes staged — skipping checks."
  exit 0
fi
if [ "$staged_source_rc" -ne 0 ]; then
  exit "$staged_source_rc"
fi

# --- 2. Non-blocking worktree lock -----------------------------------------
LOCK="${MUSI_VERIFY_LOCK:-$(musi_standard_verify_lock "$REPO_ROOT")}"
mkdir -p "$(dirname "$LOCK")"
exec 9<>"$LOCK"
if ! flock -n 9; then
  HOLDER=$(cat "$LOCK" 2>/dev/null || true)
  cat >&2 <<EOF
=== PRE-COMMIT ALREADY RUNNING ===
${HOLDER:-<holder info unavailable>}

Another pre-commit is in progress. Do NOT re-run git commit — it will
fail here again and waste tokens on repeated polling.

Wait for the in-progress run to finish before retrying git commit. If the
original run failed, its summary is already in the earlier tool output.
EOF
  exit 2
fi

# Record holder info (readable by any contender via plain cat).
{ printf 'PID=%s STARTED=%s\n' "$$" "$(date -Iseconds)"; } > "$LOCK"

# Default to a 20-minute hard budget. Callers should tune the hard and soft
# budgets with `MUSI_INTERACTIVE_TIMEOUT` / `MUSI_INTERACTIVE_WARN_AFTER`.
TOTAL_TIMEOUT="${MUSI_INTERACTIVE_TIMEOUT:-1200}"
WARN_AFTER="${MUSI_INTERACTIVE_WARN_AFTER:-1080}"

# --- 3. Cross-worktree commit queue ----------------------------------------
# Same-worktree contention fails fast above. Sibling worktrees sharing a Git
# common dir queue here so pre-commit checks serialize across Claude, Codex,
# and humans.
COMMIT_QUEUE_LOCK="${MUSI_COMMIT_QUEUE_LOCK:-$(musi_standard_commit_queue_lock "$REPO_ROOT")}"
QUEUE_WAITED=0
if [ "${MUSI_COMMIT_QUEUE_LOCK_ALREADY_HELD:-}" != "1" ]; then
  COMMIT_QUEUE_WAIT="${MUSI_COMMIT_QUEUE_TIMEOUT:-$TOTAL_TIMEOUT}"
  if [ "$COMMIT_QUEUE_WAIT" -gt "$TOTAL_TIMEOUT" ]; then
    COMMIT_QUEUE_WAIT="$TOTAL_TIMEOUT"
  fi
  mkdir -p "$(dirname "$COMMIT_QUEUE_LOCK")"
  exec 8<>"$COMMIT_QUEUE_LOCK"
  QUEUE_START=$(date +%s)
  if ! flock -w "$COMMIT_QUEUE_WAIT" 8; then
    QUEUE_HOLDER=$(cat "$COMMIT_QUEUE_LOCK" 2>/dev/null || true)
    cat >&2 <<EOF
=== COMMIT QUEUE BUSY ===
Waited ${COMMIT_QUEUE_WAIT}s for the shared commit queue lock:
$COMMIT_QUEUE_LOCK

${QUEUE_HOLDER:-<holder info unavailable>}

Another worktree is already running pre-commit for this repository. Wait for
that commit to finish, inspect the holder if it appears stuck, then retry.
EOF
    exit 2
  fi
  QUEUE_WAITED=$(( $(date +%s) - QUEUE_START ))
  [ "$QUEUE_WAITED" -gt 5 ] && printf 'pre-commit: waited %ss for shared commit queue %s\n' "$QUEUE_WAITED" "$COMMIT_QUEUE_LOCK" >&2
  {
    printf 'PID=%s WORKTREE=%s STARTED=%s\n' "$$" "$REPO_ROOT" "$(date -Iseconds)"
  } > "$COMMIT_QUEUE_LOCK"
fi

TIMEOUT=$(( TOTAL_TIMEOUT - QUEUE_WAITED ))
if [ "$TIMEOUT" -le 0 ]; then
  printf '=== PRE-COMMIT TIMED OUT (%ss budget spent waiting for commit queue) ===\n' "$TOTAL_TIMEOUT" >&2
  printf 'Timed out before checks could start.\n' >&2
  printf 'inspect: bun run verify:logs budget\n' >&2
  exit 124
fi

# --- 4. Last-verified short-circuit ----------------------------------------
MARKER="${MUSI_PRECOMMIT_MARKER:-$(musi_standard_precommit_marker "$REPO_ROOT")}"
if [ -f "$MARKER" ] && [ "${FORCE_VERIFY:-}" != "1" ]; then
  CUR_HEAD=$(git rev-parse HEAD 2>/dev/null || echo none)
  CUR_HASH=$(ai_precommit_fingerprint "$REPO_ROOT")
  if musi_success_marker_matches "$MARKER" "$CUR_HEAD" "$CUR_HASH" 120; then
    echo "pre-commit: already verified ${MUSI_MARKER_MATCH_AGE}s ago at $CUR_HEAD — skipping (set FORCE_VERIFY=1 to re-run)."
    exit 0
  fi
fi

# Manual verify is a strict superset of the changed checks here: full verify
# covers lint/ratchet/zero-baseline/test/scripts, verify:changed covers
# lint:changed/lint:ratchet/zero-baseline/test:changed/test:scripts:changed,
# and typecheck is identical.
# Pre-commit only runs test:scripts:changed when staged hook/script paths
# match (or when harness.controls.json / lint-ratchet.baseline.json change —
# see the regex below), so either manual marker also covers that optional
# step.
if musi_try_verify_marker_bridge "$REPO_ROOT" "$MARKER" 120; then
  exit 0
fi

# --- 5. Watchdog ------------------------------------------------------------
# The shared engine closes FDs 9 (worktree lock) and 8 (commit-queue lock) in
# its sleep child so a killed watchdog cannot orphan either flock and block the
# next commit until TIMEOUT elapses.
HOOK_PID=$$
musi_verify_start_watchdog "PRE-COMMIT" "$TIMEOUT" "$HOOK_PID"
WD="$MUSI_VERIFY_WATCHDOG_PID"

# --- 6. Parallel tasks -----------------------------------------------------
LOG_DIR="${MUSI_VERIFY_LOG_DIR:-$(musi_standard_verify_log_dir "$REPO_ROOT")}"
HISTORY_DIR="${MUSI_VERIFY_HISTORY_DIR:-$(musi_standard_verify_history_dir "$REPO_ROOT")}"
rm -rf "$LOG_DIR"
mkdir -p "$LOG_DIR" "$LOG_DIR/meta"
# shellcheck disable=SC2034 # Consumed by scripts/verify/steps.generated.sh.
TIMINGS_FILE="$LOG_DIR/test-timings.json"
META_DIR="$LOG_DIR/meta"
# shellcheck source=/dev/null
. "$REPO_ROOT/scripts/verify/steps.generated.sh"
# shellcheck source=/dev/null
. "$REPO_ROOT/scripts/verify/steps-lib.sh"

# Wrapper-meta breadcrumbs read by ai_stop_verify_status to decide whether the
# cached run-meta still describes the source/config state pre-commit checked.
META_HEAD=$(git rev-parse HEAD 2>/dev/null || echo none)
META_FP=$(ai_precommit_fingerprint "$REPO_ROOT")

START_TS=$(date +%s)
START_TIME=$(date -Iseconds)

PARALLEL_PIDS=()
STEP_NAMES=()
# shellcheck disable=SC2034 # Passed by name to musi_run_parallel_verify_steps.
STEP_PIDS=()
STEP_EXITS=()

# Propagate INT/TERM to children. Split traps to emit conventional exit codes:
#   INT  (Ctrl-C) → 130
#   TERM (watchdog timeout or external kill) → 124 (GNU `timeout` convention)
cleanup_parallel_children() {
  local pid
  for pid in "${PARALLEL_PIDS[@]}"; do
    [ -n "$pid" ] && musi_signal_process_tree "$pid" TERM
  done
  kill "$WD" 2>/dev/null
}
write_signal_wrapper_meta() {
  musi_verify_write_signal_meta "$1" "$META_DIR" parallel-precommit \
    "$START_TS" "$START_TIME" "$0" "$META_HEAD" "$META_FP" "$LOG_DIR" "$HISTORY_DIR"
}
trap 'cleanup_parallel_children; write_signal_wrapper_meta 130; exit 130' INT
trap 'cleanup_parallel_children; write_signal_wrapper_meta 124; musi_verify_report_timeout_budget "$LOG_DIR"; exit 124' TERM
trap 'exit_code=$?; musi_precommit_fast_provenance_on_exit "$exit_code"; kill $WD 2>/dev/null' EXIT

musi_run_parallel_verify_steps pre_commit MUSI_PRE_COMMIT_STEPS parallel-precommit "" \
  "$REPO_ROOT" STEP_NAMES STEP_PIDS STEP_EXITS PARALLEL_PIDS

# --- 7. Aggregate results --------------------------------------------------
passed=""; failed=""
for index in "${!STEP_NAMES[@]}"; do
  task="${STEP_NAMES[$index]}"
  exit_code="${STEP_EXITS[$index]}"
  [ -n "$exit_code" ] || exit_code=1
  [ "$exit_code" -eq 0 ] && passed="$passed $task" || failed="$failed $task"
done

ELAPSED=$(( $(date +%s) - START_TS ))
END_TS=$(date +%s)
END_TIME=$(date -Iseconds)

if [ -n "$failed" ]; then
  musi_verify_persist_run_meta "$META_DIR" parallel-precommit \
    "$START_TS" "$START_TIME" "$END_TS" "$END_TIME" 1 "$0" \
    "$META_HEAD" "$META_FP" "$LOG_DIR" "$HISTORY_DIR"
  # Structured lines — git-commit-quiet.sh parses these.
  musi_verify_print_failure_summary "PRE-COMMIT" "$ELAPSED" "$LOG_DIR" "$passed" "$failed"
  exit 1
fi

musi_verify_persist_run_meta "$META_DIR" parallel-precommit \
  "$START_TS" "$START_TIME" "$END_TS" "$END_TIME" 0 "$0" \
  "$META_HEAD" "$META_FP" "$LOG_DIR" "$HISTORY_DIR"

# --- 8. Success marker -----------------------------------------------------
musi_verify_finalize_success "pre-commit" "$MARKER" \
  "$(git rev-parse HEAD 2>/dev/null || echo none)" \
  "$(ai_precommit_fingerprint "$REPO_ROOT")" \
  "$ELAPSED" "$WARN_AFTER" "$TIMEOUT" "$passed"
