{
  "name": "musi",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "fast-uri": "3.1.2"
  },
  "packageManager": "bun@1.3.11",
  "engines": {
    "bun": ">=1.3.0"
  },
  "hadolint": "2.14.0",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "worktree:init": "bash scripts/worktree-db.sh init",
    "worktree:new": "bash scripts/worktree-new.sh",
    "worktree:drop": "bash scripts/worktree-db.sh drop",
    "worktree:gc": "bash scripts/worktree-db.sh gc",
    "worktree:status": "bash scripts/worktree-db.sh status",
    "worktree:template-refresh": "bash scripts/worktree-db.sh template-refresh",
    "worktree:refresh-data": "bash scripts/worktree-db.sh refresh-data",
    "build": "bun run --filter @musi/shared build && bun run --filter @musi/server build && bun run --filter @musi/client build",
    "codemod:trpc-shared-input": "bun scripts/codemods/trpc-shared-input.ts",
    "codemod:trpc-shared-output": "bun scripts/codemods/trpc-shared-output.ts",
    "codemod:concurrency-guard": "bun scripts/codemods/concurrency-guard.ts",
    "codemod:structured-logging-fix": "bun scripts/codemods/structured-logging-fix.ts",
    "codemod:expand-barrel": "bun scripts/codemods/expand-barrel.ts",
    "code:intel": "bun scripts/code-intel.ts",
    "code:intel:perf": "bun scripts/code-intel/perf-check.ts",
    "code:intel:server": "bun scripts/code-intel-server.ts",
    "test": "bash scripts/vitest.sh run --passWithNoTests",
    "test:coverage": "bash scripts/vitest.sh run --passWithNoTests --coverage",
    "test:watch": "vitest",
    "test:changed": "bash scripts/test-changed.sh",
    "test:server": "bash scripts/vitest.sh run --passWithNoTests --project=server",
    "test:client": "bash scripts/vitest.sh run --passWithNoTests --project=client",
    "test:shared": "bash scripts/vitest.sh run --passWithNoTests --project=shared",
    "test:slow": "bash scripts/test-slow.sh",
    "test:mutation": "stryker run",
    "test:scripts": "bash scripts/test-scripts.sh",
    "test:scripts:changed": "bash scripts/test-scripts.sh --changed",
    "audit:deps": "bun audit --audit-level=high && bash scripts/check-fast-uri-override.sh && bash scripts/check-eslint-react-peer-exception.sh",
    "check:fast-uri-override": "bash scripts/check-fast-uri-override.sh",
    "check:eslint-react-peer-exception": "bash scripts/check-eslint-react-peer-exception.sh",
    "lint": "bash scripts/lint.sh",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/",
    "lint:changed": "bash scripts/lint-changed.sh",
    "lint:shell": "bash scripts/lint-shell.sh",
    "lint:config-sensors": "bash scripts/lint-config-sensors.sh",
    "lint:agent:local-rules": "bun scripts/lint-agent.ts",
    "lint:agent:local-rules:changed": "bash scripts/lint-agent-changed.sh",
    "lint:ratchet": "bun scripts/lint-ratchet.ts",
    "lint:ratchet:check-baseline": "bun scripts/lint-ratchet.ts --check-baseline",
    "lint:ratchet:check-registry": "bun scripts/lint-ratchet.ts --check-registry",
    "lint:ratchet:debt-log": "bun scripts/lint-ratchet.ts --debt-log",
    "lint:ratchet:report": "bun scripts/lint-ratchet.ts --report",
    "lint:ratchet:summary": "bun scripts/lint-ratchet.ts --summary",
    "lint:ratchet:install-merge-driver": "bash scripts/git/install-lint-ratchet-merge-driver.sh",
    "lint:ratchet:update": "bun scripts/lint-ratchet.ts --update",
    "lint:ratchet:zero-baseline": "bun scripts/lint-ratchet.ts --zero-baseline",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:changed": "bash scripts/format-changed.sh",
    "format:changed:check": "bash scripts/format-changed.sh --check",
    "typecheck": "bash scripts/typecheck.sh",
    "typecheck:watch": "tsc -b --watch",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug",
    "clean": "rm -rf packages/*/dist packages/*/tsconfig.tsbuildinfo node_modules/.cache",
    "db:status": "bash scripts/db-status.sh",
    "db:migration-safety": "bash scripts/migration-safety-scan.sh",
    "doctor": "bash scripts/doctor.sh",
    "docs:harness-controls": "bun run scripts/generate-harness-controls.ts",
    "docs:harness-controls:check": "bun run scripts/generate-harness-controls.ts -- --check",
    "docs:lint-coverage-map:check": "bun run scripts/lint-coverage-map-check.ts -- --check-eslint-reach",
    "docs:lint-guidance": "bun run scripts/generate-lint-guidance.ts",
    "docs:lint-guidance:check": "bun run scripts/generate-lint-guidance.ts -- --check",
    "harness:check": "bun run scripts/harness-check.ts",
    "sensor:blob-size": "bun scripts/sensor-blob-size.ts",
    "sensor:knip": "knip --no-progress",
    "drift:ai": "bun scripts/drift-ai.ts",
    "drift:e2e": "bun scripts/drift/locator-usage.ts",
    "logs:audit": "bun scripts/logs-audit.ts",
    "module:index": "bash scripts/generate-module-index.sh",
    "module:index:check": "bash scripts/generate-module-index.sh --check",
    "verify": "bash scripts/verify.sh",
    "verify:changed": "bash scripts/verify.sh --changed",
    "verify:parallel": "bash scripts/verify.sh --parallel",
    "verify:slow": "bun run verify && bun run test:slow",
    "verify:async": "bash scripts/verify-async.sh start verify",
    "verify:async:changed": "bash scripts/verify-async.sh start changed",
    "verify:async:slow": "bash scripts/verify-async.sh start slow",
    "verify:async:status": "bash scripts/verify-async.sh status",
    "verify:async:tail": "bash scripts/verify-async.sh tail",
    "verify:async:stop": "bash scripts/verify-async.sh stop",
    "verify:history": "bash scripts/verify-history.sh",
    "verify:logs": "bash scripts/verify-logs.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.1",
    "@commitlint/config-conventional": "21.0.1",
    "@commitlint/types": "21.0.1",
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.1",
    "@eslint/js": "10.0.1",
    "@eslint/json": "1.2.0",
    "@playwright/test": "^1.60.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tanstack/eslint-plugin-query": "5.100.11",
    "@taplo/cli": "0.7.0",
    "@tktco/node-actionlint": "1.6.0",
    "@types/estree": "^1.0.9",
    "@types/node": "^24.12.4",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/eslint-plugin": "1.6.17",
    "eslint": "10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "4.16.2",
    "eslint-plugin-jsdoc": "62.9.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-playwright": "^2.10.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-regexp": "3.1.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "hadolint": "0.4.2",
    "husky": "^9.1.7",
    "jscpd": "^4.2.3",
    "knip": "6.14.1",
    "prettier": "^3.8.3",
    "ts-morph": "^28.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.7"
  }
}
