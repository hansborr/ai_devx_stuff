{
  "name": "musi",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "tools/*",
    "examples/lint-ratchet-demo"
  ],
  "overrides": {
    "fast-uri": "3.1.2"
  },
  "packageManager": "bun@1.3.11",
  "engines": {
    "bun": ">=1.3.0"
  },
  "config": {
    "hadolint": "2.14.0"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "worktree:init": "bash scripts/worktree-db.sh init",
    "worktree:new": "bash scripts/worktree-new.sh",
    "worktree:drop": "bash scripts/worktree-db.sh drop",
    "worktree:gc": "bash scripts/worktree-db.sh gc",
    "worktree:status": "bash scripts/worktree-db.sh status",
    "worktree:template-refresh": "bash scripts/worktree-db.sh template-refresh",
    "worktree:refresh-data": "bash scripts/worktree-db.sh refresh-data",
    "build": "bun run --filter @musi/shared build && bun run --filter @musi/server build && bun run --filter @musi/client build",
    "codemod:trpc-shared-input": "bun scripts/codemods/trpc-shared-input.ts",
    "codemod:trpc-shared-output": "bun scripts/codemods/trpc-shared-output.ts",
    "codemod:concurrency-guard": "bun scripts/codemods/concurrency-guard.ts",
    "codemod:structured-logging-fix": "bun scripts/codemods/structured-logging-fix.ts",
    "codemod:expand-barrel": "bun scripts/codemods/expand-barrel.ts",
    "code:intel": "bun scripts/code-intel.ts",
    "code:intel:perf": "bun scripts/code-intel/perf-check.ts",
    "code:intel:server": "bun scripts/code-intel-server.ts",
    "test": "bash scripts/test-all.sh",
    "test:coverage": "bash scripts/test-all.sh --coverage",
    "test:watch": "vitest",
    "test:changed": "bash scripts/test-changed.sh",
    "test:server": "bash scripts/vitest.sh run --passWithNoTests --project=server",
    "test:client": "bash scripts/test-client.sh",
    "test:client:isolated": "bash scripts/vitest.sh run --passWithNoTests --project=client",
    "test:client:split": "bun scripts/client-test-isolation-runner.ts",
    "test:shared": "bash scripts/vitest.sh run --passWithNoTests --project=shared",
    "test:eslint-rules": "bash scripts/vitest.sh run --passWithNoTests --project=eslint-rules",
    "test:slow": "bash scripts/test-slow.sh",
    "test:mutation": "bash -c 'trap \"rm -f stryker-setup-*.js\" EXIT INT TERM; stryker run \"$@\"' --",
    "test:scripts:mutation": "bash -c 'trap \"rm -f stryker-setup-*.js\" EXIT INT TERM; stryker run scripts/stryker-scripts.ts \"$@\"' --",
    "test:lint-ratchet:mutation": "bash -c 'trap \"rm -f stryker-setup-*.js\" EXIT INT TERM; stryker run tools/stryker-lint-ratchet.ts \"$@\"' --",
    "test:server:mutation": "bash -c 'trap \"rm -f stryker-setup-*.js\" EXIT INT TERM; stryker run stryker.config.server.mjs \"$@\"' --",
    "test:scripts": "bash scripts/test-scripts.sh",
    "test:scripts:changed": "bash scripts/test-scripts.sh --changed",
    "test:scripts:file": "bash scripts/vitest.sh run --passWithNoTests --project=scripts",
    "test:scripts:subjects": "bun run scripts/path-policy/generate-smoke-subjects.ts",
    "test:scripts:subjects:check": "bun run scripts/path-policy/generate-smoke-subjects.ts -- --check",
    "eval:lint-messages": "bun scripts/lint-message-eval.ts",
    "audit:deps": "bun audit --audit-level=high && bash scripts/check-fast-uri-override.sh && bash scripts/check-eslint-react-peer-exception.sh",
    "audit:licenses": "bun scripts/audit-dependency-licenses.ts",
    "backlog:lint": "bun run scripts/backlog-lint.ts",
    "check:fast-uri-override": "bash scripts/check-fast-uri-override.sh",
    "check:eslint-react-peer-exception": "bash scripts/check-eslint-react-peer-exception.sh",
    "lint": "bash scripts/lint.sh",
    "lint:fix": "bash scripts/lint-fix.sh",
    "lint:changed": "bash scripts/lint-changed.sh",
    "lint:probe-rule": "bun scripts/lint-probe-rule.ts",
    "lint:shell": "bash scripts/lint-shell.sh",
    "lint:config-sensors": "bash scripts/lint-config-sensors.sh",
    "lint:import-cycles": "bash scripts/lint-import-cycles.sh",
    "lint:max-lines-exceptions": "bun scripts/max-lines-exceptions.ts",
    "lint:max-lines-exceptions:install-merge-driver": "bash scripts/git/install-max-lines-exceptions-merge-driver.sh",
    "lint:max-lines-exceptions:merge-driver:check": "bash scripts/git/check-max-lines-exceptions-merge-driver.sh",
    "lint:max-lines-exceptions:update": "bun scripts/max-lines-exceptions.ts --update",
    "lint:restricted-disable-rules": "bun run scripts/harness/generate-restricted-disable-rules.ts",
    "lint:restricted-disable-rules:check": "bun run scripts/harness/generate-restricted-disable-rules.ts -- --check",
    "lint:suppressions": "bash scripts/lint-suppressions.sh",
    "lint:suppressions:changed": "bash scripts/lint-suppressions.sh --changed",
    "lint:agent:local-rules": "bun scripts/lint-agent.ts",
    "lint:agent:local-rules:changed": "bash scripts/lint-agent-changed.sh",
    "baseline:restore-stage": "bash scripts/git/restore-generated-baseline-stage.sh",
    "lint:ratchet": "bash scripts/lint-ratchet.sh",
    "lint:ratchet:check-baseline": "bun scripts/lint-ratchet.ts --check-baseline",
    "lint:ratchet:check-debt-accounting": "bun scripts/lint-ratchet.ts --check-debt-accounting",
    "lint:ratchet:check-registry": "bun scripts/lint-ratchet.ts --check-registry",
    "lint:ratchet:debt-log": "bun scripts/lint-ratchet.ts --debt-log",
    "lint:ratchet:report": "bun scripts/lint-ratchet.ts --report",
    "lint:ratchet:summary": "bun scripts/lint-ratchet.ts --summary",
    "lint:ratchet:trend": "bun scripts/lint-ratchet.ts --trend",
    "lint:ratchet:install-merge-driver": "bash scripts/git/install-lint-ratchet-merge-driver.sh",
    "lint:ratchet:merge-driver:check": "bash scripts/git/check-lint-ratchet-merge-driver.sh",
    "lint:ratchet:update": "bun scripts/lint-ratchet.ts --update",
    "lint:ratchet:zero-baseline": "bun scripts/lint-ratchet.ts --zero-baseline",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:changed": "bash scripts/format-changed.sh",
    "format:changed:check": "bash scripts/format-changed.sh --check",
    "typecheck": "bash scripts/typecheck.sh",
    "typecheck:watch": "tsc -b --watch",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug",
    "clean": "rm -rf packages/*/dist packages/*/tsconfig.tsbuildinfo tools/*/dist tools/*/tsconfig.tsbuildinfo node_modules/.cache",
    "db:status": "bun run scripts/db-status.ts",
    "db:migration-safety": "bash scripts/migration-safety-scan.sh",
    "doctor": "bash scripts/doctor.sh",
    "docs:baseline-conflict-recipes": "bun run scripts/generate-baseline-conflict-recipes.ts",
    "docs:baseline-conflict-recipes:check": "bun run scripts/generate-baseline-conflict-recipes.ts -- --check",
    "docs:harness-controls": "bun run scripts/harness/generate-harness-controls.ts",
    "docs:harness-controls:check": "bun run scripts/harness/generate-harness-controls.ts -- --check",
    "docs:local-eslint-rule-starter:check": "bun scripts/check-local-eslint-rule-starter.ts",
    "docs:lint-coverage-map:check": "bun run scripts/lint-coverage-map-check.ts",
    "docs:lint-coverage-map:audit": "bun run scripts/lint-coverage-map-check.ts -- --check-eslint-reach",
    "docs:lint-coverage-map:suggest": "bun run scripts/lint-coverage-map-check.ts -- --suggest",
    "docs:lint-guidance": "bun run scripts/generate-lint-guidance.ts",
    "docs:lint-guidance:check": "bun run scripts/generate-lint-guidance.ts -- --check",
    "harness:audit": "bun scripts/harness-audit.ts",
    "harness:config-surfaces": "bun run scripts/harness/generate-config-surfaces.ts",
    "harness:config-surfaces:check": "bun run scripts/harness/generate-config-surfaces.ts -- --check",
    "harness:hook-timeouts": "bun run scripts/harness/generate-hook-timeout-constants.ts",
    "harness:hook-timeouts:check": "bun run scripts/harness/generate-hook-timeout-constants.ts -- --check",
    "harness:wiring": "bun run scripts/harness/generate-hook-wiring.ts",
    "harness:wiring:check": "bun run scripts/harness/generate-hook-wiring.ts -- --check",
    "harness:check": "bun run scripts/harness-check.ts",
    "sensor:blob-size": "bun scripts/sensor-blob-size.ts",
    "sensor:knip": "knip --no-progress",
    "sensor:knip-unused-exports": "bun scripts/sensor-knip-unused-exports.ts",
    "sensor:knip-unused-exports:install-merge-driver": "bash scripts/git/install-knip-unused-exports-merge-driver.sh",
    "sensor:knip-unused-exports:merge-driver:check": "bash scripts/git/check-knip-unused-exports-merge-driver.sh",
    "sensor:near-duplicates": "bun scripts/sensor-near-duplicates.ts",
    "sensor:near-duplicates:install-merge-driver": "bash scripts/git/install-near-duplicates-merge-driver.sh",
    "sensor:near-duplicates:merge-driver:check": "bash scripts/git/check-near-duplicates-merge-driver.sh",
    "drift:ai": "bun scripts/drift-ai.ts",
    "drift:triage": "bun scripts/drift-triage.ts",
    "drift:e2e": "bun scripts/drift/locator-usage.ts",
    "logs:audit": "bun scripts/logs-audit.ts",
    "module:index": "bash scripts/generate-module-index.sh",
    "module:index:check": "bash scripts/generate-module-index.sh --check",
    "verify": "bash scripts/verify.sh",
    "verify:steps": "bun run scripts/harness/generate-verify-steps.ts",
    "verify:steps:check": "bun run scripts/harness/generate-verify-steps.ts -- --check",
    "verify:changed": "bash scripts/verify.sh --changed",
    "verify:parallel": "bash scripts/verify.sh --parallel",
    "verify:slow": "bun run verify && bun run test:slow",
    "verify:async": "bash scripts/verify-async.sh start verify",
    "verify:async:changed": "bash scripts/verify-async.sh start changed",
    "verify:async:slow": "bash scripts/verify-async.sh start slow",
    "verify:async:status": "bash scripts/verify-async.sh status",
    "verify:async:tail": "bash scripts/verify-async.sh tail",
    "verify:async:stop": "bash scripts/verify-async.sh stop",
    "verify:history": "bash scripts/verify-history.sh",
    "verify:logs": "bash scripts/verify-logs.sh",
    "prepare": "husky && bash scripts/git/install-all-merge-drivers.sh",
    "postinstall": "sh scripts/write-install-digest.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@commitlint/cli": "21.0.1",
    "@commitlint/config-conventional": "21.0.1",
    "@commitlint/types": "21.0.1",
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.1",
    "@eslint/js": "10.0.1",
    "@eslint/json": "1.2.0",
    "@musi/lint-ratchet": "workspace:*",
    "@playwright/test": "^1.60.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tanstack/eslint-plugin-query": "5.100.11",
    "@taplo/cli": "0.7.0",
    "@tktco/node-actionlint": "1.6.0",
    "@types/estree": "^1.0.9",
    "@types/node": "^24.12.4",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/eslint-plugin": "1.6.17",
    "eslint": "10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "4.16.2",
    "eslint-plugin-jsdoc": "62.9.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-playwright": "^2.10.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "eslint-plugin-regexp": "3.1.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-testing-library": "7.16.2",
    "hadolint": "0.4.2",
    "husky": "^9.1.7",
    "jscpd": "^4.2.3",
    "knip": "6.14.1",
    "minimatch": "10.2.4",
    "prettier": "^3.8.3",
    "ts-morph": "^28.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.7",
    "zod": "^4.4.3"
  }
}
