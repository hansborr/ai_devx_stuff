{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "deny": [
      "Bash(git commit *--amend*)",
      "Bash(git push *--force*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--delete*)",
      "Bash(git push *--prune*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push -d*)",
      "Bash(git push * -d*)",
      "Bash(git push +*)",
      "Bash(git push * +*)",
      "Bash(git push :*)",
      "Bash(git push * :*)",
      "Bash(git reset *--hard*)",
      "Bash(git reset *--soft*)",
      "Bash(git reset *--merge*)",
      "Bash(git reset *--keep*)",
      "Bash(git reset HEAD~*)",
      "Bash(git reset * HEAD~*)",
      "Bash(git reset HEAD^*)",
      "Bash(git reset * HEAD^*)",
      "Bash(git reset ORIG_HEAD*)",
      "Bash(git reset * ORIG_HEAD*)",
      "Bash(git clean -*f*)",
      "Bash(git clean * -*f*)",
      "Bash(git clean *--force*)",
      "Bash(git branch *--force*)",
      "Bash(git branch *--delete*--force*)",
      "Bash(git branch *--force*--delete*)",
      "Bash(git branch -D*)",
      "Bash(git branch * -D*)",
      "Bash(git branch -f*)",
      "Bash(git branch * -f*)",
      "Bash(git branch -df*)",
      "Bash(git branch * -df*)",
      "Bash(git branch -fd*)",
      "Bash(git branch * -fd*)",
      "Bash(git branch -M*)",
      "Bash(git branch * -M*)",
      "Bash(git branch -C*)",
      "Bash(git branch * -C*)",
      "Bash(git tag *--delete*)",
      "Bash(git tag *--force*)",
      "Bash(git tag -d*)",
      "Bash(git tag * -d*)",
      "Bash(git tag -f*)",
      "Bash(git tag * -f*)",
      "Bash(git worktree remove *--force*)",
      "Bash(git worktree remove -f*)",
      "Bash(git worktree remove * -f*)",
      "Bash(git checkout *--force*)",
      "Bash(git checkout -f*)",
      "Bash(git checkout * -f*)",
      "Bash(git checkout -- *)",
      "Bash(git checkout * -- *)",
      "Bash(git checkout .)",
      "Bash(git switch *--force*)",
      "Bash(git switch -f*)",
      "Bash(git switch * -f*)",
      "Bash(git restore *--worktree*)",
      "Bash(git restore -W*)",
      "Bash(git restore * -W*)",
      "Bash(git restore -- .)",
      "Bash(git restore * -- .)",
      "Bash(git restore .)",
      "Bash(git restore ./*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(git replace*)",
      "Bash(git update-ref*)",
      "Bash(git reflog expire*)",
      "Bash(gh auth login:*)",
      "Bash(gh auth logout:*)",
      "Bash(gh auth token:*)",
      "Bash(gh auth refresh:*)",
      "Bash(gh auth setup-git:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/no-direct-db.sh"
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/git-commit-quiet.sh",
            "timeout": 600
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/bun-run-quiet.sh",
            "timeout": 280
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/protected-files.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/prisma-generate.sh",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/doc-length.sh"
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/tidy-edited-file.sh",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/lint-coverage-check.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/ratchet-regression-check.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/parallel-cancel-note.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/stop-reminder.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "playwright@claude-plugins-official": false,
    "prisma@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true
  }
}
