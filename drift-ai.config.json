{
  "roots": [
    "packages/shared/src",
    "packages/server/src",
    "packages/client/src",
    "scripts",
    "eslint-rules"
  ],
  "ignore": {
    "prefixes": ["docs/", "packages/server/prisma/migrations/"]
  },
  "checks": {
    "ghost-files": {
      "dependentsHint": "Run: bun run code:intel -- dependents {path}",
      "currentAllowedPairs": [
        [
          "packages/client/src/components/campaign/maps/map-canvas-helpers.ts",
          "packages/client/src/components/campaign/maps/map-canvas.tsx"
        ],
        ["packages/client/src/pages/join-page.tsx", "packages/client/src/pages/login-page.tsx"],
        ["packages/client/src/routes/join-route.ts", "packages/client/src/routes/login-route.ts"],
        ["packages/client/src/test/mock-trpc-helpers.ts", "packages/client/src/test/mock-trpc.tsx"],
        ["scripts/drift-ai/config-match.ts", "scripts/drift-ai/config-paths.ts"],
        [
          "packages/server/src/services/character-create-helpers.ts",
          "packages/server/src/services/character-create.ts"
        ],
        ["packages/server/src/utils/map-helpers.ts", "packages/server/src/utils/map-types.ts"]
      ]
    },
    "comments": {
      "excludePrefixes": ["scripts/", "eslint-rules/"]
    }
  }
}
