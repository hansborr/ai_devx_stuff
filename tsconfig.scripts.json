{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true
    // No `paths` aliases for @musi/lint-ratchet here: TypeScript `paths`
    // bypasses `package.json#exports`, so a wildcard alias would let scripts
    // typecheck private package subpaths that fail at runtime. Scripts resolve
    // the package through the workspace symlink and its enumerated exports map
    // (leaf 14), exactly like Bun's runtime — unlisted subpaths fail closed in
    // both places. The exports targets point at TypeScript source, which tsc
    // accepts under `allowImportingTsExtensions`-free Node16 resolution because
    // the target files exist on disk.
  },
  "include": ["scripts/**/*.ts"],
  "exclude": [
    "scripts/codemods/fixtures/**",
    "scripts/drift-ai/fixtures/**",
    "scripts/fixtures/**",
    "scripts/harness-audit/fixtures/**",
    "scripts/logs-audit/fixtures/**",
    "scripts/vitest.config.ts"
  ]
}
