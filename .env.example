# Musi — Environment Variables
# Copy this file to .env and fill in the values.
# cp .env.example .env

# --- Database (PostgreSQL) ---
POSTGRES_DB=musi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ThisIsNotTheRealDatabasePassword
DATABASE_URL=postgresql://postgres:ThisIsNotTheRealDatabasePassword@localhost:8002/musi
# Optional Prisma PostgreSQL adapter pool maximum. Must be a positive integer.
# DATABASE_POOL_MAX=10
TEST_DATABASE_URL=postgresql://postgres:ThisIsNotTheRealDatabasePassword@localhost:8002/musi_test
E2E_DATABASE_URL=postgresql://postgres:ThisIsNotTheRealDatabasePassword@localhost:8002/musi_test_e2e

# --- Redis ---
REDIS_URL=redis://localhost:8004
# Set to "true" to enable the Socket.io Redis adapter.
# ENABLE_REDIS_ADAPTER=false

# --- Server ---
# NODE_ENV=development
# SERVER_PORT=8001
CORS_ORIGIN=http://localhost:8000

# --- Logging ---
# Log level: fatal, error, warn, info, debug, trace (default: info)
# LOG_LEVEL=info

# --- Rate Limiting ---
# Set to "true" to disable all rate limiting (useful for dev/testing)
# DISABLE_RATE_LIMIT=true
# Set to "true" to relax auth rate limits during e2e runs
# E2E_TEST=false
# Any non-empty value runs the skipped auth timing-oracle tests AND keeps
# bcrypt hash generation at production cost under NODE_ENV=test
# RUN_TIMING_TESTS=1

# --- Uploads ---
# Directory for user-uploaded files (default: ./uploads relative to server cwd)
# UPLOADS_DIR=./uploads

# --- Client ---
# Override the API server URL used by the client for non-tRPC requests (file uploads, static assets).
# Default: http://localhost:8001
# VITE_API_URL=http://localhost:8001

# --- Auth (generate secrets with: openssl rand -base64 48) ---
JWT_SECRET=ThisIsNotTheRealDatabasePassword-generate-a-real-secret
