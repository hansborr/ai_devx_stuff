# Copy this file to .env and fill in values before starting the container.
# cp .devcontainer/.env.example .devcontainer/.env

# Sets the compose project name, which prefixes volume names and is used
# as the container name. Use lowercase letters, digits, and hyphens only.
PROJECT_NAME=musi

TZ=America/Los_Angeles

# --- Database ---
POSTGRES_DB=musi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://postgres:changeme@db:5432/musi
TEST_DATABASE_URL=postgresql://postgres:changeme@db:5432/musi_test
E2E_DATABASE_URL=postgresql://postgres:changeme@db:5432/musi_test_e2e

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Server ---
CORS_ORIGIN=http://localhost:8000

# --- Auth (generate with: openssl rand -base64 48) ---
# The placeholder below is a known dev-only secret: it is >=32 chars so an
# unedited copy boots in development, and it is on the server's
# UNSAFE_PRODUCTION_JWT_SECRETS denylist so a copy that reaches production is
# rejected at startup instead of signing tokens with a public secret.
# Replace it with a real secret before any non-local use.
JWT_SECRET=dev-only-jwt-secret-do-not-use-in-production
